    requirementQuantity: 1
  - initialDialog: []
    autoPilotMapping: 8
    autoPilotDialog:
    - name: 11
      dialog: The components I claimed will form the core of something greater.
    - name: 0
      dialog: Oh, what's that?
    - name: 11
      dialog: A weapon. One designed to silence the void.
    - name: 11
      dialog: And now... we build it together.
    inputTutorialStep: 0
    situationalTutorial: 0
    requirementType: 999
    requirementTarget: 
    requirementQuantity: 1
  - initialDialog:
    - name: 19
      dialog: Why did that feel less like a gift and more like a veiled ultimatum?
    - name: 18
      dialog: I'm done trying to figure her out. Let's get to Earth then we'll deal
        with it.
