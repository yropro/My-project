      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.28
      type: 13
      value: "\u2022 I controlli degli scudi dei raggi e la gestione delle liste
        di navi non allocano pi\xF9 memoria a ogni tick."
