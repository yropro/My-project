      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.26
      type: 13
      value: "\u2022 Il rendering dei contorni delle navi riutilizza lo stato grafico
        invece di reimpostarlo per ogni parte."
      baseValue: "\u2022 Ship outline rendering reuses graphics state instead of
