      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.35
      type: 13
      value: "\u2022 I Laser di difesa ravvicinata non prendono pi\xF9 di mira i
        missili innocui degli alleati ormai partiti."
      baseValue: "\u2022 Point Defense Lasers no longer target harmless missiles
        from departed allies."
