      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.36
      type: 13
      value: "\u2022 Annulla dopo il caricamento di un modello o un'importazione
        ora ripristina la nave precedente."
      baseValue: "\u2022 Undo after loading a template or import now restores your
        previous ship."
