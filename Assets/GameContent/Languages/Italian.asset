      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.4
      type: 13
      value: "\u2022 Il doppio clic sullo scontro attuale in Navigazione non attiva
        pi\xF9 il salto iperspaziale."
      baseValue: "\u2022 Double-clicking your current encounter in Navigation no
        longer hyperjumps you."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.5
      type: 13
      value: "\u2022 Corretto un errore nell'Assemblatore quando si spostavano oggetti
        nel deposito."
      baseValue: "\u2022 Fixed error in Assembler when trying to move items to storage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.6
      type: 13
      value: "\u2022 Corretti i crediti che si dividevano in pi\xF9 pile di carico."
      baseValue: "\u2022 Fixed credits splitting into multiple cargo stacks."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.title
      type: 13
      value: Ricalibrazione
      baseValue: Recalibration
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.0
      type: 13
      value: "<color=#ffffff>Nuove funzionalit\xE0 / Contenuti</color>"
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.1
      type: 13
      value: "\u2022 Il nuovo Hangar dell'Assemblatore conserva fino a 10 progetti
        di nave tra cui passare."
      baseValue: "\u2022 New Assembler Hangar Bay stores up to 10 ship designs you
        can switch between."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.2
      type: 13
      value: "\u2022 Ripristinare i potenziamenti non costa pi\xF9 crediti, quindi
        sperimenta pure."
      baseValue: "\u2022 Resetting upgrades no longer costs credits, so feel free
        to experiment."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.3
      type: 13
      value: "\u2022 Ora puoi depositare crediti nel Deposito locale e in quello
        condiviso presso l'Assemblatore."
      baseValue: "\u2022 Credits can now be deposited into Local and Shared Vaults
        at the Assembler."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.4
      type: 13
      value: "\u2022 I settori ora includono Cache fisse che rilasciano oggetti rari
        predefiniti."
      baseValue: "\u2022 Sectors now include fixed caches that drop pre-defined rare
        items."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.5
      type: 13
      value: "\u2022 Nuova arma secondaria: il Cannone gravitazionale cattura detriti,
        missili e droni."
      baseValue: "\u2022 New secondary weapon: the Gravity Cannon captures debris,
        missiles and drones."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.6
      type: 13
      value: "\u2022 I Laser di difesa ravvicinata risparmiano le rocce e i droni
        che il tuo Cannone gravitazionale vuole come munizioni."
      baseValue: "\u2022 Point Defense Lasers spare rocks and drones your Gravity
        Cannon wants as ammo."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.7
      type: 13
      value: "\u2022 Il nuovo oggetto Transponder permette alle build da tank di
        generare passivamente minaccia sui nemici."
      baseValue: "\u2022 New Transponder item allows tank builds to passively gain
        threat on enemies."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.8
      type: 13
      value: "\u2022 Aggiunto un nuovo avatar tra cui scegliere durante la creazione
        di un pilota."
      baseValue: "\u2022 Added a new player avatar to choose from when creating a
        pilot."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.9
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
