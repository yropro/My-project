      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.55
      type: 13
      value: "\u2022 Le copie del Motore olografico ora usano il tipo di danno del
        tuo scudo invece di uno casuale."
      baseValue: "\u2022 Holo Drive images now copy your shield's damage type instead
        of a random one."
