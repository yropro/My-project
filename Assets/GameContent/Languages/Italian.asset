    - key: SettingsDataControl.cameraDistance.tooltip
      type: 8
      value: "Distanza della telecamera dal giocatore: maggiore \xE8 il valore, pi\xF9
        piccolo apparir\xE0 tutto."
      baseValue: Distance of camera from player, the larger the number the smaller
        everything will be.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.uiScale.description
      type: 7
      value: Scala UI
      baseValue: UI Scale
