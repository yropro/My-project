      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.56
      type: 13
      value: "\u2022 La musica del Broodnest non continua pi\xF9 in uno scontro dopo
        che il Broodnest \xE8 scomparso."
      baseValue: "\u2022 Broodnest music no longer plays in an encounter after the
        Broodnest is gone."
