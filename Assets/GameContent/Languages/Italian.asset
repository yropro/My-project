      type: 13
      value: <color=#ffffff>Modifiche al bilanciamento</color>
      baseValue: <color=#ffffff>Balance Changes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.11
      type: 13
      value: "\u2022 La dimensione della nave ora moltiplica la minaccia generata,
        fino a x10 per i Dreadnought."
      baseValue: "\u2022 Ship size now multiplies threat generated, up to x10 for
        Dreadnoughts."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.12
      type: 13
      value: "\u2022 L'Alone di riparazione ora ripara anche i tuoi droni e le tue
        torrette."
      baseValue: "\u2022 Repair Halo now also repairs your own drones and turrets."
      context: 
      aiTranslated: 1
      keptEnglish: 0
