      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.33
      type: 13
      value: "\u2022 Corretto un errore dopo la distruzione di un capo squadrone
        controllato mentalmente."
      baseValue: "\u2022 Fixed an error after a mind-controlled squadron leader was
        destroyed."
