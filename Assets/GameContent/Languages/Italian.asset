      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.1
      type: 13
      value: "\u2022 La nuova impostazione Qualit\xE0 della nebulosa offre una nebbia
        pi\xF9 veloce su Medio e Basso per i PC datati."
      baseValue: "\u2022 New Nebula Quality setting offers faster Medium and Low
        fog for older PCs."
      context: 
      aiTranslated: 1
      keptEnglish: 0
