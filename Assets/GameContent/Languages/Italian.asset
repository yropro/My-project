      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.39
      type: 13
      value: "\u2022 I pozzi gravitazionali e i buchi neri non fanno pi\xF9 volare
        via i segmenti dei nemici serpente."
      baseValue: "\u2022 Gravity wells and black holes no longer send snake enemy
        segments flying."
