      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.32
      type: 13
      value: "\u2022 Le mappe stellari di Radar e Navigazione ora concordano su quali
        stelle contengono bottino."
      baseValue: "\u2022 Radar and Navigation star maps no longer disagree on which
        stars hold loot."
