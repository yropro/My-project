      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.24
      type: 13
      value: "\u2022 I pozzi gravitazionali sovrapposti ora si fondono in un unico
        pozzo con danni cumulati."
      baseValue: "\u2022 Overlapping gravity wells now merge into a single well with
        stacked damage."
