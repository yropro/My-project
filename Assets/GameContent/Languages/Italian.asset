      baseValue: Credits and Attribution
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: PtAWL7BT
      type: 9
      value: Grazie per aver giocato
      baseValue: Thanks For Playing
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: d0PwM3QM
      type: 8
      value: "Grazie per aver dedicato del tempo a provare la demo!\n\nStar Vortex
        \xE8 ora disponibile in Accesso Anticipato! Acquista la tua copia su Steam
        e continua il tuo viaggio. Tutti i salvataggi saranno trasferiti alla versione
        completa!"
      baseValue: 'Thanks for taking the time to checkout the demo!


        Star
        Vortex is out now in Early Access! Grab your copy on Steam and continue your
        journey. All saves carry over to the full version!'
      context: 
      aiTranslated: 1
      keptEnglish: 0
