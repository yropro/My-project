      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.37
      type: 13
      value: "\u2022 La lista delle parti dell'Editor di navi non si apre pi\xF9
        gi\xE0 scorsa a met\xE0."
      baseValue: "\u2022 The Ship Builder parts list no longer opens scrolled partway
