    - key: core.updateHistory.v0.7.95.11
      type: 13
      value: "\u2022 \u98DE\u8239\u4F53\u578B\u73B0\u5728\u4F1A\u653E\u5927\u4EA7\u751F\u7684\u5A01\u80C1\uFF0C\u65E0\u754F\u8230\u6700\u9AD8\u53EF\u8FBE
        10 \u500D\u3002"
      baseValue: "\u2022 Ship size now multiplies threat generated, up to x10 for
        Dreadnoughts."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.12
      type: 13
      value: "\u2022 \u4FEE\u590D\u5149\u73AF\u73B0\u5728\u4E5F\u4F1A\u4FEE\u590D\u4F60\u81EA\u5DF1\u7684\u65E0\u4EBA\u673A\u548C\u70AE\u5854\u3002"
      baseValue: "\u2022 Repair Halo now also repairs your own drones and turrets."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.13
      type: 13
      value: "\u2022 \u4FEE\u590D\u5C04\u7EBF\u73B0\u5728\u7784\u51C6\u4F60\u81EA\u5DF1\u7684\u65E0\u4EBA\u673A\u548C\u70AE\u5854\u65F6\u4E5F\u80FD\u4FEE\u590D\u5B83\u4EEC\u3002"
      baseValue: "\u2022 Repair Ray can now repair your own drones and turrets when
        aimed at them."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.14
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.15
      type: 13
      value: "<color=#ffffff>\u4F53\u9A8C\u4F18\u5316 / \u65E0\u969C\u788D</color>"
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
