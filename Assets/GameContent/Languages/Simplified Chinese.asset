    - key: faction.junker.1.0
      type: 2
      value: "\u67A2\u79D8\u4F1A\u98DE\u8239\uFF0C\u4F60\u771F\u662F\u8BA9\u6211\u4EEC\u9AD8\u5174\u574F\u4E86\u3002\u5173\u6389\u7535\u6E90\uFF0C\u6211\u4EEC\u8D76\u7D27\u5904\u7406\u3002"
      baseValue: Conclave ship, you just made our day. Power down and we'll make
        this quick.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: faction.junker.1.1
      type: 2
      value: "\u771F\u68D2\u3002\u6709\u91CE\u5FC3\u7684\u6D77\u76D7\u2026\u2026\u800C\u4E14\u6BEB\u65E0\u81EA\u4FDD\u80FD\u529B\u3002"
