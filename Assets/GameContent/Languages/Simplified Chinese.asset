    - key: oPuSchCr.arrivalDialog.3
      type: 2
      value: "\u518D\u6B21\u51B2\u5411\u7A81\u7834\u53E3\uFF0C\u6240\u6709\u98DE\u8239\u90FD\u52A0\u5165\u6218\u6597\uFF01"
