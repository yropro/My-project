      aiTranslated: 0
      keptEnglish: 0
    - key: faction.flora.2.3
      type: 2
      value: "\u5B83\u5728\u5632\u8BBD\u4F60\u7684\u7CBE\u51C6\u6027\uFF0C\u56E0\u4E3A\u4F60\u7784\u5F97\u4E0D\u51C6......"
