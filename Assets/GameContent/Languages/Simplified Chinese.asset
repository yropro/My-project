      aiTranslated: 0
      keptEnglish: 0
    - key: faction.shadow.2.0
      type: 2
      value: "\u8FD9\u4E9B\u77E5\u8BC6\u4ECE\u6765\u5C31\u4E0D\u662F\u4E3A\u4F60\u51C6\u5907\u7684\u3002"
