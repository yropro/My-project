      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: faction.shadow.1.2
      type: 2
      value: "\u72E9\u730E\u5DF2\u7ECF\u7ED3\u675F\u4E86\u3002"
      baseValue: The hunt is already over.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: faction.shadow.1.3
      type: 2
      value: "\u6211\u8BA4\u4E3A\u8FD9\u662F\u4ED6\u4EEC\u8BF4\u6211\u4EEC\u6709\u9EBB\u70E6\u4E86\u7684\u65B9\u5F0F\u3002"
