    - key: core.updateHistory.v0.7.91.31
      type: 13
      value: "\u2022 \u56FE\u9274\u4E2D\u7684\u4FEE\u6B63\u6A21\u5757\u6700\u5927\u503C\u73B0\u5728\u4F1A\u53CD\u6620\u7A00\u6709\u548C\u4F20\u5947\u66F4\u9AD8\u7684\u4E0A\u9650\u3002"
      baseValue: "\u2022 Glossary max modifier values now reflect the higher Rare
        and Legendary caps."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.32
      type: 13
      value: "\u2022 \u96F7\u8FBE\u661F\u56FE\u4E0E\u5BFC\u822A\u661F\u56FE\u4E0D\u518D\u5BF9\u54EA\u4E9B\u661F\u7403\u85CF\u6709\u6218\u5229\u54C1\u51FA\u73B0\u5206\u6B67\u3002"
      baseValue: "\u2022 Radar and Navigation star maps no longer disagree on which
        stars hold loot."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.33
      type: 13
      value: "\u2022 \u4FEE\u590D\u4E86\u88AB\u63A5\u7BA1\u7684\u4E2D\u961F\u957F\u88AB\u6467\u6BC1\u540E\u51FA\u73B0\u7684\u9519\u8BEF\u3002"
      baseValue: "\u2022 Fixed an error after a mind-controlled squadron leader was
        destroyed."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.34
      type: 13
      value: "\u2022 \u4FEE\u590D\u4E86\u9F99\u5377\u98CE\u5BFC\u5F39\u56E0\u8F6C\u5411\u963B\u5C3C\u8FC7\u6162\u800C\u5728\u53D1\u5C04\u65F6\u66F2\u6298\u98DE\u884C\u7684\u95EE\u9898\u3002"
      baseValue: "\u2022 Fixed Tornado missiles zigzagging at launch due to slow
        steering damping."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.35
      type: 13
      value: "\u2022 \u70B9\u9632\u5FA1\u6FC0\u5149\u4E0D\u518D\u7784\u51C6\u5DF2\u79BB\u5F00\u7684\u76DF\u53CB\u7559\u4E0B\u7684\u65E0\u5BB3\u5BFC\u5F39\u3002"
      baseValue: "\u2022 Point Defense Lasers no longer target harmless missiles
        from departed allies."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.36
      type: 13
      value: "\u2022 \u8F7D\u5165\u6A21\u677F\u6216\u5BFC\u5165\u540E\u4F7F\u7528\u64A4\u6D88\uFF0C\u73B0\u5728\u4F1A\u8FD8\u539F\u4F60\u4E4B\u524D\u7684\u98DE\u8239\u3002"
      baseValue: "\u2022 Undo after loading a template or import now restores your
        previous ship."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.37
      type: 13
      value: "\u2022 \u8230\u8239\u7F16\u8F91\u5668\u7684\u90E8\u4EF6\u5217\u8868\u6253\u5F00\u65F6\u4E0D\u518D\u505C\u7559\u5728\u4E2D\u9014\u6EDA\u52A8\u4F4D\u7F6E\u3002"
      baseValue: "\u2022 The Ship Builder parts list no longer opens scrolled partway
        along."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.38
      type: 13
      value: "\u2022 \u624B\u67C4\u9009\u62E9\u4E0D\u518D\u9009\u4E2D\u5DF2\u6EDA\u52A8\u5230\u89C6\u91CE\u4E4B\u5916\u7684\u5217\u8868\u9879\u3002"
      baseValue: "\u2022 Controller selection no longer picks list items scrolled
        out of view."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.39
      type: 13
      value: "\u2022 \u5F15\u529B\u4E95\u548C\u9ED1\u6D1E\u4E0D\u518D\u5C06\u86C7\u5F62\u654C\u4EBA\u7684\u5206\u6BB5\u5439\u98DE\u3002"
      baseValue: "\u2022 Gravity wells and black holes no longer send snake enemy
        segments flying."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.40
      type: 13
      value: "\u2022 \u6218\u6597\u4E2D\u98DE\u8239\u4F17\u591A\u65F6\uFF0C\u86C7\u5F62\u654C\u4EBA\u7684\u5206\u6BB5\u4E0D\u518D\u5F7C\u6B64\u6563\u5F00\u3002"
      baseValue: "\u2022 Snake enemy segments no longer drift apart when many ships
        are in the fight."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.41
      type: 13
      value: "\u2022 \u8230\u8239\u7F16\u8F91\u5668\u7684\u63A8\u8FDB\u5668\u69FD\u4F4D\u73AF\u73B0\u5728\u663E\u793A\u5728\u8239\u4F53\u4E0A\u65B9\uFF0C\u800C\u4E0D\u662F\u4E0B\u65B9\u3002"
      baseValue: "\u2022 Ship Builder thruster slot rings now show above the hull
        instead of under it."
      context: 
      aiTranslated: 1
      keptEnglish: 0
