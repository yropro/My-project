    - key: core.updateHistory.v0.8.05.0
      type: 13
      value: "<color=#ffffff>\u65B0\u529F\u80FD / \u5185\u5BB9</color>"
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.1
      type: 13
      value: "\u2022 \u65B0\u589E\u4E86\u7E41\u4F53\u4E2D\u6587\u8BED\u8A00\u652F\u6301\u3002"
      baseValue: "\u2022 Added Traditional Chinese language support."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.2
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.3
      type: 13
      value: "<color=#ffffff>\u4F53\u9A8C\u4F18\u5316 / \u65E0\u969C\u788D</color>"
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.4
      type: 13
      value: "\u2022 \u8BED\u8A00\u5217\u8868\u73B0\u5728\u4F1A\u7528\u4F60\u81EA\u5DF1\u7684\u8BED\u8A00\u663E\u793A\u6BCF\u79CD\u8BED\u8A00\u7684\u540D\u79F0\u3002"
      baseValue: "\u2022 Language list now shows each language's name in your own
        language."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.5
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.6
      type: 13
      value: "<color=#ffffff>\u9519\u8BEF\u4FEE\u590D</color>"
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.7
      type: 13
      value: "\u2022 \u51B7\u5374\u4E2D\u7684\u5DF2\u88C5\u5907\u7269\u54C1\u5728\u79FB\u5165\u4ED3\u5E93\u65F6\u4E0D\u518D\u88AB\u590D\u5236\u3002"
      baseValue: "\u2022 Equipped items on cooldown no longer duplicate when moved
        into storage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.8
      type: 13
      value: "\u2022 \u4FEE\u590D\u4E86\u5728\u591A\u4EBA\u6E38\u620F\u4E2D\u5F00\u7740\u9762\u677F\u6B7B\u4EA1\u5BFC\u81F4\u98DE\u8239\u8FDB\u5165\u4E0D\u6B7B\u72B6\u6001\u7684\u95EE\u9898\u3002"
      baseValue: "\u2022 Fixed dying with a panel open in multiplayer leaving the
        ship immortal."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.9
      type: 13
      value: "\u2022 \u53D7\u4E0D\u6B7B\u98DE\u8239\u9519\u8BEF\u5F71\u54CD\u7684\u5B58\u6863\u73B0\u5728\u4F1A\u5728\u4E0B\u6B21\u91CD\u751F\u65F6\u6062\u590D\u3002"
      baseValue: "\u2022 Saves affected by the immortal ship bug now recover on the
        next respawn."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.10
      type: 13
      value: "\u2022 \u591A\u4EBA\u6E38\u620F\u4E2D\u4EA7\u751F\u7684\u65E0\u6CD5\u4F7F\u7528\u7684\u591A\u4F59\u7AD9\u70B9\u5BC6\u7801\u73B0\u5728\u4F1A\u88AB\u81EA\u52A8\u79FB\u9664\u3002"
      baseValue: "\u2022 Unusable extra Gateway Ciphers from multiplayer are now
        removed automatically."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.11
      type: 13
      value: "\u2022 \u4FEE\u6B63\u4E86\u7B80\u4F53\u4E2D\u6587\u6587\u672C\u4E2D\u7684\u591A\u5904\u7FFB\u8BD1\u9519\u8BEF\u3002"
      baseValue: "\u2022 Fixed a number of mistranslations in the Simplified Chinese
        text."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.0
      type: 13
      value: "<color=#ffffff>\u9519\u8BEF\u4FEE\u590D</color>"
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.1
      type: 13
      value: "\u2022 \u8131\u79BB\u5BF9\u63A5\u65F6\u73B0\u5728\u4F1A\u91CD\u5EFA\u8239\u4F53\u78B0\u649E\uFF0C\u8BA9\u6CA1\u6709\u62A4\u76FE\u7684\u98DE\u8239\u4E5F\u80FD\u6536\u96C6\u7269\u54C1\u3002"
      baseValue: "\u2022 Undocking now rebuilds hull collision so shieldless ships
        can collect items."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.2
      type: 13
      value: "\u2022 \u4FEE\u590D\u4E86\u5728\u5408\u4F5C\u6A21\u5F0F\u4E2D\u63A5\u624B\u5B58\u5728\u88AB\u63A7\u5236\u98DE\u8239\u7684\u906D\u9047\u6218\u65F6\u51FA\u73B0\u7684\u9519\u8BEF\u3002"
      baseValue: "\u2022 Fixed an error taking over a co-op encounter holding a mind-controlled
        ship."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.3
      type: 13
      value: "\u2022 \u4FEE\u590D\u4E86\u5C06\u955C\u50CF\u5149\u675F\u6B66\u5668\u79FB\u52A8\u5230\u975E\u955C\u50CF\u69FD\u4F4D\u540E\u51FA\u73B0\u7684\u9519\u8BEF\u3002"
      baseValue: "\u2022 Fixed an error after moving a mirrored beam weapon to an
        unmirrored slot."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.4
      type: 13
      value: "\u2022 \u4FEE\u590D\u4E86\u65F6\u95F4\u6682\u505C\u65F6\u65E0\u4EBA\u673A\u6216\u70AE\u5854\u5931\u53BB\u8239\u4F53\u90E8\u4EF6\u5BFC\u81F4\u7684\u9519\u8BEF\u3002"
      baseValue: "\u2022 Fixed an error when a drone or turret lost a hull part while
        time was paused."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.5
      type: 13
      value: "\u2022 \u4FEE\u590D\u4E86\u5728\u4E3B\u673A\u5B8C\u6210\u906D\u9047\u6218\u65F6\u52A0\u5165\u4F1A\u8BDD\u51FA\u73B0\u7684\u9519\u8BEF\u3002"
      baseValue: "\u2022 Fixed an error joining a session while the host completed
        an encounter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.0
      type: 13
      value: "<color=#ffffff>\u9519\u8BEF\u4FEE\u590D</color>"
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.1
      type: 13
      value: "\u2022 \u5408\u4F5C\u6A21\u5F0F\u4E3B\u673A\u79FB\u4EA4\u540E\uFF0C\u98DE\u8239\u4E0D\u518D\u5728\u5165\u4FB5\u7ED3\u675F\u65F6\u88AB\u5206\u5165\u9519\u8BEF\u7684\u4E2D\u961F\u3002"
      baseValue: "\u2022 Co-op host handoffs no longer put ships in the wrong squadron
        post-invasion."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.2
      type: 13
      value: "\u2022 \u98DE\u8239\u8BBE\u8BA1\u73B0\u5728\u4F1A\u5728\u70B9\u51FB\u5B8C\u6210\u65F6\u786E\u5B9A\u62A4\u76FE\u5C3A\u5BF8\uFF0C\u4FEE\u590D\u4E86\u5FEB\u901F\u5173\u95ED\u65F6\u51FA\u73B0\u7684\u9519\u8BEF\u3002"
      baseValue: "\u2022 Ship designs now size the shield on Finish, fixing an error
        when closed fast."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.3
      type: 13
      value: "\u2022 \u5165\u4FB5\u8005\u4E0D\u518D\u6269\u6563\u5230\u5408\u4F5C\u6A21\u5F0F\u73A9\u5BB6\u6B63\u5728\u8DC3\u8FC1\u524D\u5F80\u7684\u906D\u9047\u6218\u3002"
      baseValue: "\u2022 Invaders no longer spread to an encounter a co-op player
        is jumping into."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.4
      type: 13
      value: "\u2022 \u865A\u62DF\u952E\u76D8\u73B0\u5728\u4F1A\u968F\u6240\u5C5E\u7269\u54C1\u9762\u677F\u4E00\u540C\u5173\u95ED\uFF0C\u4FEE\u590D\u4E86\u53D6\u6D88\u65F6\u51FA\u73B0\u7684\u9519\u8BEF\u3002"
      baseValue: "\u2022 On-screen keyboard now closes with its item panel, fixing
        an error on Cancel."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.5
      type: 13
      value: "\u2022 \u4EE5\u7269\u54C1\u5F62\u5F0F\u5B58\u50A8\u7684\u4FE1\u7528\u5E01\u73B0\u5728\u65E0\u6CD5\u4E22\u5F03\u3002"
      baseValue: "\u2022 Credits stored as an item can no longer be discarded or
        dropped."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.0
      type: 13
      value: "<color=#ffffff>\u65B0\u529F\u80FD / \u5185\u5BB9</color>"
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.1
      type: 13
      value: "\u2022 \u6F14\u793A\u7248\u4E0E\u6B63\u5F0F\u7248\u73A9\u5BB6\u73B0\u5728\u53EF\u4EE5\u770B\u5230\u5F7C\u6B64\u7684\u4EC5\u9650
        Steam \u597D\u53CB\u6E38\u620F\u3002"
      baseValue: "\u2022 Demo and full-game players can now see each other's Steam
        Friends Only games."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.2
      type: 13
      value: "\u2022 \u8DEF\u7531\u5668\u7AEF\u53E3\u672A\u5F00\u653E\u7684\u6E38\u620F\u73B0\u5728\u4E5F\u53EF\u4EE5\u4ECE\u6E38\u620F\u5217\u8868\u4E2D\u52A0\u5165\u3002"
      baseValue: "\u2022 Games behind a closed router port can now be joined from
        the game list."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.3
      type: 13
      value: "\u2022 \u53CC\u65B9\u73A9\u5BB6\u90FD\u62E5\u6709\u6F14\u793A\u7248\u65F6\uFF0C\u6F14\u793A\u7248\u6E38\u620F\u73B0\u5728\u4F1A\u901A\u8FC7
        Steam \u8FDE\u63A5\u3002"
      baseValue: "\u2022 Demo games now connect through Steam when both players own
        the demo."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.4
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.5
      type: 13
      value: "<color=#ffffff>\u4F53\u9A8C\u4F18\u5316 / \u65E0\u969C\u788D</color>"
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.6
      type: 13
      value: "\u2022 \u897F\u73ED\u7259\u8BED\u7FFB\u8BD1\u5DF2\u6539\u4E3A\u901A\u7528\u897F\u73ED\u7259\u8BED\uFF0C\u540C\u65F6\u9002\u7528\u4E8E\u897F\u73ED\u7259\u548C\u62C9\u4E01\u7F8E\u6D32\u3002"
      baseValue: "\u2022 Spanish translation revised to neutral Spanish for Spain
        and Latin America."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.7
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.8
      type: 13
      value: "<color=#ffffff>\u9519\u8BEF\u4FEE\u590D</color>"
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.9
      type: 13
      value: "\u2022 \u5728\u83DC\u5355\u52A0\u8F7D\u5B8C\u6210\u524D\u63A5\u53D7\u7684
        Steam \u9080\u8BF7\u4E0D\u518D\u8DF3\u8FC7\u7248\u672C\u68C0\u67E5\u3002"
      baseValue: "\u2022 Steam invites accepted before the menu loads no longer skip
        the version check."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.10
      type: 13
      value: "\u2022 \u5408\u4F5C\u6A21\u5F0F\u73A9\u5BB6\u79BB\u5F00\u906D\u9047\u6218\u65F6\uFF0C\u654C\u65B9\u4E2D\u961F\u4E0D\u518D\u5C11\u4E00\u8258\u98DE\u8239\u3002"
      baseValue: "\u2022 Enemy squadrons no longer lose a ship when a co-op player
        leaves an encounter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.11
      type: 13
      value: "\u2022 \u901A\u8FC7 IPv6 \u521B\u5EFA\u7684\u516C\u5F00\u6E38\u620F\u73B0\u5728\u4F1A\u88AB\u5217\u51FA\uFF0C\u5E76\u53EF\u4ECE\u6E38\u620F\u5217\u8868\u4E2D\u52A0\u5165\u3002"
      baseValue: "\u2022 Public games hosted over IPv6 are now listed and joinable
        from the game list."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.12
      type: 13
      value: "\u2022 \u4FEE\u590D\u4E86\u5728\u98DE\u8239\u9762\u677F\u4ECD\u5728\u6253\u5F00\u65F6\u79BB\u5F00\u6E38\u620F\u540E\u51FA\u73B0\u7684\u8F93\u5165\u9519\u8BEF\u3002"
      baseValue: "\u2022 Fixed an input error after leaving a game with a ship panel
        still opening."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.0
      type: 13
      value: "<color=#ffffff>\u4F53\u9A8C\u4F18\u5316 / \u65E0\u969C\u788D</color>"
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.1
      type: 13
      value: "\u2022 MOD \u4E0D\u5339\u914D\u7684\u9519\u8BEF\u73B0\u5728\u4F1A\u6307\u51FA\u7F3A\u5C11\u3001\u591A\u4F59\u6216\u7248\u672C\u4E0D\u7B26\u7684
        MOD\u3002"
      baseValue: "\u2022 Mod mismatch errors now name the missing, extra or wrong-version
        mods."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.2
      type: 13
      value: "\u2022 \u6E38\u620F\u5217\u8868\u63D0\u793A\u73B0\u5728\u4F1A\u663E\u793A\u4E3B\u673A\u7684
        MOD\uFF0C\u5E76\u6807\u51FA\u5176\u4E2D\u6709\u5DEE\u5F02\u7684\u9879\u3002"
      baseValue: "\u2022 Game list tooltips now show the host's mods and flag any
        that differ."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.3
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.4
      type: 13
      value: "<color=#ffffff>\u6027\u80FD</color>"
      baseValue: <color=#ffffff>Performance</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.5
      type: 13
      value: "\u2022 \u5408\u4F5C\u6A21\u5F0F\u7684\u6218\u6597\u6570\u636E\u73B0\u5728\u5C0F\u5F97\u591A\uFF0C\u6709\u52A9\u4E8E\u7F51\u7EDC\u8F83\u5DEE\u7684\u73A9\u5BB6\u3002"
      baseValue: "\u2022 Co-op combat data is now far smaller, helping players on
        weaker connections."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.6
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.7
      type: 13
      value: "<color=#ffffff>\u9519\u8BEF\u4FEE\u590D</color>"
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.8
      type: 13
      value: "\u2022 \u7F51\u7EDC\u7F13\u6162\u5BFC\u81F4\u6570\u636E\u77ED\u6682\u79EF\u538B\u65F6\uFF0CSteam
        \u73A9\u5BB6\u4E0D\u518D\u88AB\u65AD\u5F00\u8FDE\u63A5\u3002"
      baseValue: "\u2022 Steam players are no longer dropped when a slow connection
        briefly backs up."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.9
      type: 13
      value: "\u2022 \u97F3\u9891\u53D1\u58F0\u6570\u4E0A\u9650\u8FC7\u4F4E\u5DF2\u4FEE\u6B63\uFF0C\u5927\u89C4\u6A21\u6218\u6597\u4E2D\u97F3\u4E50\u4E0D\u518D\u5361\u987F\u3002"
      baseValue: "\u2022 Music no longer stutters in big fights, as the audio voice
        limit was too low."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.10
      type: 13
      value: "\u2022 \u8D85\u8FC7 1.4 \u516C\u91CC\u7684\u8FDC\u5904\u58F0\u97F3\u73B0\u5728\u4F1A\u5B8C\u5168\u6DE1\u51FA\uFF0C\u800C\u4E0D\u662F\u5FAE\u5F31\u6B8B\u7559\u3002"
      baseValue: "\u2022 Distant sounds now fade to silence beyond 1.4 km instead
        of lingering faintly."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.11
      type: 13
      value: "\u2022 \u97F3\u91CF\u6ED1\u5757\u73B0\u5728\u4F1A\u5728\u542F\u52A8\u65F6\u751F\u6548\uFF0C\u800C\u4E0D\u662F\u5728\u9996\u6B21\u4FDD\u5B58\u8BBE\u7F6E\u4E4B\u540E\u3002"
      baseValue: "\u2022 Volume sliders now apply on launch instead of after the
        first settings save."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.12
      type: 13
      value: "\u2022 AI \u98DE\u8239\u7684\u70AE\u5854\u5728\u76EE\u6807\u6D88\u5931\u540E\u73B0\u5728\u4F1A\u8F6C\u56DE\u6B63\u524D\u65B9\u3002"
      baseValue: "\u2022 AI ship turrets now swing back forward once their target
        is gone."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.13
      type: 13
      value: "\u2022 \u88AB\u8F6C\u5316\u7684\u98DE\u8239\u52A0\u5165\u4E2D\u961F\u65F6\uFF0C\u96F7\u8FBE\u661F\u56FE\u4E0A\u7684\u654C\u4EBA\u6570\u91CF\u4E0D\u518D\u5361\u4F4F\u3002"
      baseValue: "\u2022 Radar enemy count no longer freezes when a converted ship
        joins a squadron."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.14
      type: 13
      value: "\u2022 \u8FDB\u5165\u597D\u53CB\u7684\u906D\u9047\u6218\u540E\uFF0C\u4F60\u7684\u98DE\u8239\u4E0D\u518D\u53D8\u767D\u5E76\u5361\u4F4F\u3002"
      baseValue: "\u2022 Arriving in a friend's encounter no longer leaves your ship
        white and stuck."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.15
      type: 13
      value: "\u2022 \u5F15\u529B\u52A0\u519C\u7684\u5C04\u5F39\u73B0\u5728\u4F1A\u5728\u98DE\u884C\u7ED3\u675F\u65F6\u7206\u70B8\uFF0C\u800C\u4E0D\u662F\u76F4\u63A5\u6D88\u5931\u3002"
      baseValue: "\u2022 Gravity Cannon shots now explode at the end of their flight,
        not just vanish."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.16
      type: 13
      value: "\u2022 \u643A\u5E26\u6DA1\u65CB\u9635\u5217\u5728\u906D\u9047\u6218\u4E4B\u95F4\u8DF3\u8DC3\u4E0D\u518D\u51FA\u73B0\u9519\u8BEF\u3002"
      baseValue: "\u2022 Jumping between encounters with a Vortex Array no longer
        causes an error."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.title
      type: 13
      value: "\u591A\u4EBA\u6E38\u620F"
      baseValue: Multiplayer
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.0
      type: 13
      value: "<color=#ffffff>\u65B0\u529F\u80FD / \u5185\u5BB9</color>"
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.1
      type: 13
      value: "\u2022 \u4E0E\u597D\u53CB\u5728\u7EBF\u6E38\u73A9\uFF1A\u6700\u591A\u652F\u6301
        8 \u540D\u73A9\u5BB6\u7684\u5408\u4F5C\u591A\u4EBA\u6A21\u5F0F\u3002"
      baseValue: "\u2022 Play online with friends: co-op multiplayer for up to 8
        players."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.2
      type: 13
      value: "\u2022 \u654C\u4EBA\u7684\u5F3A\u5EA6\u4F1A\u968F\u4F1A\u8BDD\u4E2D\u7684\u73A9\u5BB6\u6570\u91CF\u63D0\u5347\u3002"
      baseValue: "\u2022 Enemies scale in strength with the number of players in
        the session."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.3
      type: 13
      value: "\u2022 \u51FB\u6740\u83B7\u5F97\u7684\u7ECF\u9A8C\u4F1A\u4E0E\u540C\u4E00\u573A\u906D\u9047\u6218\u4E2D\u7684\u73A9\u5BB6\u5171\u4EAB\u3002"
      baseValue: "\u2022 Experience from kills is shared with players in the same
        encounter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.4
      type: 13
      value: "\u2022 \u521B\u5EFA\u4F1A\u8BDD\u65F6\u53EF\u8BBE\u7F6E\u540D\u79F0\u3001\u53EF\u9009\u5BC6\u7801\u3001\u73A9\u5BB6\u4E0A\u9650\u548C\u53EF\u89C1\u6027\u3002"
      baseValue: "\u2022 Host sessions with a name, optional password, player cap,
        and visibility."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.5
      type: 13
      value: "\u2022 \u53EF\u901A\u8FC7\u516C\u5F00\u6E38\u620F\u5217\u8868\u3001\u5C40\u57DF\u7F51\u641C\u7D22\u3001Steam
        \u597D\u53CB\u6216 IP \u67E5\u627E\u6E38\u620F\u3002"
      baseValue: "\u2022 Find games via the public game list, LAN discovery, Steam
        friends, or IP."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.6
      type: 13
      value: "\u2022 \u63A5\u53D7 Steam \u9080\u8BF7\u5373\u53EF\u76F4\u63A5\u52A0\u5165\u597D\u53CB\u7684\u4F1A\u8BDD\u3002"
      baseValue: "\u2022 Accept a Steam invite to jump straight into a friend's session."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.7
      type: 13
      value: "\u2022 \u6E38\u620F\u53EF\u6839\u636E\u9700\u8981\u8BBE\u7F6E\u4E3A
        PVP / \u5171\u4EAB\u6218\u5229\u54C1\u3002"
      baseValue: "\u2022 Games can be set to PVP / Shared Loot as desired."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.8
      type: 13
      value: "\u2022 \u786C\u6838\u98DE\u884C\u5458\u4E0E\u5E38\u89C4\u98DE\u884C\u5458\u53EF\u4EE5\u5728\u540C\u4E00\u4F1A\u8BDD\u4E2D\u4E00\u8D77\u6E38\u73A9\u3002"
      baseValue: "\u2022 Hardcore and Regular pilots can play together in the same
        session."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.9
      type: 13
      value: "\u2022 \u591A\u4EBA\u6E38\u620F\u7684 HUD \u65B0\u589E\u6587\u5B57\u804A\u5929\uFF0C\u5E76\u914D\u6709\u7528\u4E8E\u6FC0\u6D3B\u7684\u65B0\u6309\u952E\u7ED1\u5B9A\u3002"
      baseValue: "\u2022 Text chat added to HUD in multiplayer games with new keybinding
        to activate."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.10
      type: 13
      value: "\u2022 \u96F7\u8FBE\u661F\u56FE\u65C1\u7684\u73A9\u5BB6\u5217\u8868\u4F1A\u663E\u793A\u5176\u4ED6\u73A9\u5BB6\u7684\u72B6\u6001\u548C\u4F4D\u7F6E\u3002"
      baseValue: "\u2022 Player list next to Radar shows other players' status and
        location."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.11
      type: 13
      value: "\u2022 \u82E5\u4E3B\u673A\u65AD\u5F00\u8FDE\u63A5\uFF0C\u6E38\u620F\u4F1A\u65E0\u7F1D\u5207\u56DE\u5355\u4EBA\u6E38\u620F\u3002"
      baseValue: "\u2022 If the host disconnects the game seamlessly drops back into
        single player."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.12
      type: 13
      value: "\u2022 \u6F14\u793A\u7248\u5305\u542B\u5B8C\u6574\u591A\u4EBA\u6E38\u620F\uFF0C\u53EF\u52A0\u5165\u7B2C
        1 \u661F\u533A\u7684\u6B63\u5F0F\u7248\u4F1A\u8BDD\u3002"
      baseValue: "\u2022 Demo includes full multiplayer and can join full-game sessions
        in Sector 1."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.13
      type: 13
      value: "\u2022 \u591A\u4EBA\u6E38\u620F\u4E2D\u7684\u5BF9\u8BDD\u73B0\u5728\u4F1A\u5728\u6218\u6597\u671F\u95F4\u4E3A\u6240\u6709\u4EBA\u6682\u505C\u906D\u9047\u6218\u3002"
      baseValue: "\u2022 Dialogs in multiplayer now pause the encounter for everyone
        during combat."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.14
      type: 13
      value: "\u2022 \u591A\u4EBA\u6E38\u620F\u7684\u5BF9\u8BDD\u4F1A\u6309\u9605\u8BFB\u8BA1\u65F6\u81EA\u52A8\u63A8\u8FDB\uFF0C\u4E0D\u4F1A\u8BA9\u4EFB\u4F55\u4EBA\u4E00\u76F4\u5361\u4F4F\u3002"
      baseValue: "\u2022 Multiplayer dialogs auto-advance on a reading timer so no
        one stays frozen."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.15
      type: 13
      value: "\u2022 \u73A9\u5BB6\u5217\u8868\u73B0\u5728\u4F1A\u663E\u793A\u54EA\u4E9B\u73A9\u5BB6\u6B63\u5728\u9605\u8BFB\u5BF9\u8BDD\u3002"
      baseValue: "\u2022 Player list now shows which players are reading a dialog."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.16
      type: 13
      value: "\u2022 \u591A\u4EBA\u6E38\u620F\u5217\u8868\u7684\u65B0\u63D0\u793A\u4F1A\u663E\u793A\u6BCF\u4F4D\u73A9\u5BB6\u7684\u540D\u79F0\u3001\u7B49\u7EA7\u548C\u6A21\u5F0F\u3002"
      baseValue: "\u2022 New multiplayer game list tooltips show each player's name,
        level, and mode."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.17
      type: 13
      value: "\u2022 \u4E3B\u673A\u73B0\u5728\u53EF\u4EE5\u4F7F\u7528 /kick \u548C
        /ban \u804A\u5929\u6307\u4EE4\u8E22\u51FA\u6216\u5C01\u7981\u73A9\u5BB6\u3002"
      baseValue: "\u2022 Hosts can now kick or ban players with the /kick and /ban
        chat commands."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.18
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.19
      type: 13
      value: "<color=#ffffff>\u5E73\u8861\u6027\u8C03\u6574</color>"
      baseValue: <color=#ffffff>Balance Changes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.20
      type: 13
      value: "\u2022 \u96C6\u7ED3\u53F7\u4E2D\u7684\u7A00\u6709\u5EA6\u5347\u7EA7\u8D39\u7528\u5DF2\u51CF\u534A\u3002"
      baseValue: "\u2022 Rarity upgrade costs in the Assembler have been halved."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.21
      type: 13
      value: "\u2022 \u4F60\u7684\u98DE\u8239\u5728\u8230\u961F\u4E2D\u4E0D\u4F1A\u518D\u88AB\u6467\u6BC1\uFF0C\u56E0\u6B64\u91CD\u751F\u59CB\u7EC8\u5B89\u5168\u3002"
      baseValue: "\u2022 Your ship can no longer be destroyed at the fleet, so respawns
        are always safe."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.22
      type: 13
      value: "\u2022 \u51B0\u51BB\u706B\u70AC\u548C\u52A8\u80FD\u5BFC\u7BA1\u73B0\u5DF2\u5728\u6BCD\u8230\u4E2D\u51FA\u552E\u3002"
      baseValue: "\u2022 Cryo Torch and Kinetic Conduit are now available for sale
        in the mothership."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.23
      type: 13
      value: "\u2022 \u5999\u5C14\u5C3C\u5C14\u7684\u95EA\u7535\u7403\u901F\u5EA6\u63D0\u9AD8
        40%\u3002"
      baseValue: "\u2022 Increased speed of Mj\xF6lnir's Lightning Orb by 40%."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.24
      type: 13
      value: "\u2022 Species-XI \u6BCD\u5DE2\u7684\u8239\u4F53\u503C\u6062\u590D\u964D\u4F4E
        25%\u3002"
      baseValue: "\u2022 Reduced Hull Regen of Species-XI Broodnest by 25%."
      context: 
      aiTranslated: 1
      keptEnglish: 0
