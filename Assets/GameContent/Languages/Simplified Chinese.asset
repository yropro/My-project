    - key: faction.pantheon.1.0
      type: 2
      value: "\u4E00\u8258\u5B64\u72EC\u7684\u8239\u2026\u2026\u88AB\u4ED6\u4EEC\u65E0\u6CD5\u7406\u89E3\u7684\u529B\u91CF\u5F15\u5165\u6B67\u9014\u3002"
