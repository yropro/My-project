  - categoryName: Component.Death
    entries:
    - key: Death.regularDesc
      type: 8
      value: "\u60A8\u5DF2\u6B7B\u4EA1\u5E76\u4E22\u5931\u4E86 {0} \u4E2A\u4FE1\u7528\u5E01\u3002\u60A8\u60F3\u91CD\u751F\u5417\uFF1F"
      baseValue: You have died and dropped {0} credit(s). Would you like to respawn?
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: Death.hardcoreDesc
      type: 8
      value: "\u5BF9\u4E8E\u786C\u6838\u73A9\u5BB6\u6765\u8BF4\uFF0C\u91CD\u751F\u662F\u7981\u7528\u7684\u3002"
      baseValue: Respawn is disabled for hardcore players.
      context: 
