    - key: core.updateHistory.v0.7.96.4
      type: 13
      value: "\u2022 \u5728\u5BFC\u822A\u9762\u677F\u4E2D\u53CC\u51FB\u5F53\u524D\u6240\u5728\u7684\u906D\u9047\u6218\u4E0D\u518D\u89E6\u53D1\u8D85\u7EA7\u8DC3\u8FC1\u3002"
      baseValue: "\u2022 Double-clicking your current encounter in Navigation no
        longer hyperjumps you."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.5
      type: 13
      value: "\u2022 \u4FEE\u590D\u4E86\u5728\u96C6\u7ED3\u53F7\u4E2D\u5C1D\u8BD5\u5C06\u7269\u54C1\u79FB\u5165\u4ED3\u5E93\u65F6\u7684\u9519\u8BEF\u3002"
      baseValue: "\u2022 Fixed error in Assembler when trying to move items to storage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.6
      type: 13
      value: "\u2022 \u4FEE\u590D\u4E86\u4FE1\u7528\u5E01\u5206\u88C2\u6210\u591A\u4E2A\u8D27\u8231\u5806\u53E0\u7684\u95EE\u9898\u3002"
      baseValue: "\u2022 Fixed credits splitting into multiple cargo stacks."
      context: 
      aiTranslated: 1
      keptEnglish: 0
