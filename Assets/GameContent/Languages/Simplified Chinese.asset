    - key: uO5YJWRH
      type: 18
      value: "\u60A8\u60F3\u4E86\u89E3\u6709\u5173\u5982\u4F55\u4F7F\u7528\u98DE\u8239\u8BBE\u8BA1\u5668\u7684\u66F4\u591A\u4FE1\u606F\u5417\uFF1F"
      baseValue: Would you like more information on how to use the ship designer?
      context: 
      aiTranslated: 0
