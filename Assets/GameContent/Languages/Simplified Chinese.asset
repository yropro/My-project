    - key: core.updateHistory.v0.8.0.33
      type: 13
      value: "\u2022 \u7784\u51C6\u8F85\u52A9\u73B0\u5728\u5BF9\u6DF7\u88C5\u5C45\u4E2D\u4E0E\u504F\u5FC3\u6B66\u5668\u7684\u98DE\u8239\u4E5F\u6709\u6548\u3002"
      baseValue: "\u2022 Aim assist now works on ships mixing centered and off-center
