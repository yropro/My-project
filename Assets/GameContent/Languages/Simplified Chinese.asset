    - key: T748amiF.arrivalDialog.0
      type: 2
      value: "\u4E00\u8258\u67A2\u79D8\u4F1A\u98DE\u8239\u2026\u2026\u51FA\u4E4E\u610F\u6599\u3002\u4F60\u662F\u6765\u89C1\u8BC6\u4E00\u4E0B\u81EA\u7531\u7684\u771F\u9762\u76EE\u5417\uFF1F"
