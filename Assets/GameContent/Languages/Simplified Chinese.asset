    - key: core.updateHistory.v0.8.0.63
      type: 13
      value: "\u2022 Equippable \u7684\u6750\u8D28\u4E0E\u989C\u8272 Overwrite/Revert
        \u65B9\u6CD5\u73B0\u5728\u4E3A virtual\u3002"
      baseValue: "\u2022 Equippable material and color Overwrite/Revert methods are
