    - key: faction.shadow.2.1
      type: 2
      value: "\u542C\u8D77\u6765\u4ED6\u4EEC\u6B63\u5728\u641C\u522E\u6B8B\u9AB8\u2026\u2026\u53EF\u80FD\u662F\u5E7B\u5F71\u6280\u672F\u3002"
