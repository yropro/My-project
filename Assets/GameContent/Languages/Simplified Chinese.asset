    - key: core.updateHistory.v0.7.91.44
      type: 13
      value: "\u2022 SceneGlowFeature.RegisterLine \u53EF\u5C06\u81EA\u5B9A\u4E49\u7EBF\u6761\u53D1\u5149\u4F53\u52A0\u5165\u8F89\u5149\u6355\u83B7\u3002"
      baseValue: "\u2022 SceneGlowFeature.RegisterLine adds custom line emitters
        to the glow capture."
