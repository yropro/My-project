      value: "\u2022 \u653E\u7F6E\u69FD\u4F4D\u65F6\u63A8\u8FDB\u5668\u4F1A\u663E\u793A\u8F6E\u5ED3\uFF0C\u56E0\u4E3A\u5B83\u4EEC\u4F1A\u9690\u85CF\u5728\u8239\u4F53\u4E0B\u65B9\u3002"
      baseValue: "\u2022 Thrusters show a silhouette while placing slots as they
        hide under the hull."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.15
      type: 13
      value: 
      baseValue: 
      context: 
