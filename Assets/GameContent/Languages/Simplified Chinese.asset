    - key: oPuSchCr.arrivalDialog.0
      type: 2
      value: "\u4F60\u50CF\u4E4B\u524D\u7684\u6240\u6709\u5F81\u670D\u8005\u4E00\u6837\u51B2\u5411\u68F1\u955C\u2026\u2026\u5374\u5BF9\u81EA\u5DF1\u4E0D\u7406\u89E3\u7684\u4E8B\u7269\u89C6\u800C\u4E0D\u89C1\u3002"
