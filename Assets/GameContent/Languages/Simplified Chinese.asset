    - key: faction.flora.2.0
      type: 2
      value: "\u6211\u53D1\u73B0\u4E86\u8FD9\u4E2A\u3002"
      baseValue: I found this.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: faction.flora.2.1
      type: 2
      value: "\u54E6\uFF0C\u4F60\u53C8\u6765\u5E2E\u52A9\u6211\u4EEC\u4E86\u5417\uFF1F"
