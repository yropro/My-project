    - key: faction.flora.2.2
      type: 2
      value: "\u5B64\u8EAB\u4E00\u4EBA\uFF0C\u4F60\u82E6\u82E6\u6323\u624E\u3002\u643A\u624B\u5171\u8FDB\uFF0C\u6216\u8BB8\u80FD\u6709\u6240\u8FDB\u6B65\u3002"
