      aiTranslated: 0
      keptEnglish: 0
    - key: faction.grays.1.3
      type: 2
      value: "\u4E0D\u8981\u62B5\u6297\u3002\u670D\u4ECE\u547D\u4EE4\u53EF\u6700\u5927\u7A0B\u5EA6\u5730\u51CF\u5C11\u7EC4\u7EC7\u635F\u5931\u3002"
