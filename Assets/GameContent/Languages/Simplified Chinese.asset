    - key: core.updateHistory.v0.7.91.45
      type: 13
      value: "\u2022 \u65B0\u589E AIController.IsFormationSlaved \u548C GravityWell.TryMerge
        \u516C\u5171\u8F85\u52A9\u65B9\u6CD5\u3002"
      baseValue: "\u2022 New AIController.IsFormationSlaved and GravityWell.TryMerge
        public helpers."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.46
      type: 13
      value: "\u2022 SceneGlowFeature.ExcludeRenderer \u53EF\u5C06 LDR \u7CBE\u7075\u56FE\u6392\u9664\u5728\u8F89\u5149\u6355\u83B7\u4E4B\u5916\u3002"
      baseValue: "\u2022 SceneGlowFeature.ExcludeRenderer opts LDR sprites out of
        the glow capture."
