    - key: faction.shadow.2.2
      type: 2
      value: "\u592A\u597D\u4E86\u3002\u53C8\u6709\u66F4\u591A\u5077\u6765\u7684\u6B66\u5668\u6765\u5BF9\u4ED8\u6211\u4EEC\u4E86\u3002"
