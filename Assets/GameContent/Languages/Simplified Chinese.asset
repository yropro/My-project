      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: T748amiF.arrivalDialog.3
      type: 2
      value: "\u6211\u6709\u70B9\u559C\u6B22\u8FD9\u4E9B\u5BB6\u4F19\u2026\u2026"
