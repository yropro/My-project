      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.16
      type: 13
      value: "<color=#ffffff>\u6027\u80FD</color>"
      baseValue: <color=#ffffff>Performance</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.17
      type: 13
      value: "\u2022 \u7269\u7406\u6A21\u62DF\u6BCF\u5E27\u6700\u591A\u8FFD\u8D76
        3 \u6B65\uFF0C\u4EE5\u6D88\u9664\u6FC0\u70C8\u6218\u6597\u4E2D\u7684\u5361\u987F\u3002"
      baseValue: "\u2022 Physics now catches up at most 3 steps per frame to stop
        heavy-battle stutter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.18
      type: 13
      value: "\u2022 \u98DE\u8239\u5C5E\u6027\u67E5\u8BE2\u4E0D\u518D\u91CD\u65B0\u626B\u63CF\u5168\u90E8\u88C5\u5907\uFF0C\u5927\u578B\u914D\u88C5\u7684\u901F\u5EA6\u66F4\u5FEB\u3002"
      baseValue: "\u2022 Ship stat lookups no longer rescan all equipment, speeding
        up big loadouts."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.19
      type: 13
      value: "\u2022 \u707C\u70E7\u3001\u8F90\u5C04\u548C\u523A\u7A7F\u7684\u4F24\u5BB3\u6539\u4E3A\u6279\u91CF\u7ED3\u7B97\uFF0C\u4EE5\u964D\u4F4E
        CPU \u8D1F\u62C5\u3002"
      baseValue: "\u2022 Burning, Radioactive and Impaled damage ticks in batches
        to cut CPU load."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.20
      type: 13
      value: "\u2022 \u81EA\u52A8\u6B66\u5668\u73B0\u5728\u4F1A\u77ED\u6682\u590D\u7528\u5C04\u51FB\u901A\u8DEF\u68C0\u6D4B\uFF0C\u800C\u4E0D\u662F\u6BCF\u6B21\u5237\u65B0\u90FD\u91CD\u65B0\u68C0\u6D4B\u3002"
      baseValue: "\u2022 Auto-weapons reuse their line-of-fire check briefly instead
        of every tick."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.21
      type: 13
      value: "\u2022 \u98DE\u8239\u8840\u6761\u548C\u72B6\u6001\u56FE\u6807\u73B0\u5728\u4F1A\u88AB\u590D\u7528\uFF0C\u800C\u4E0D\u662F\u6BCF\u6B21\u91CD\u65B0\u751F\u6210\u3002"
      baseValue: "\u2022 Ship health bars and status icons are reused instead of
        rebuilt each time."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.22
      type: 13
      value: "\u2022 \u6BCF\u8258\u98DE\u8239\u98DE\u884C\u4E2D\u7684\u5438\u53D6\u79CD\u5B50\u4E0A\u9650\u4E3A
        30\uFF1B\u8D85\u51FA\u7684\u5438\u53D6\u5C06\u7ACB\u5373\u6CBB\u7597\u3002"
      baseValue: "\u2022 Leech seeds now cap at 30 in flight per ship; extra leech
        heals instantly."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.23
      type: 13
      value: "\u2022 \u5F15\u529B\u4E95\u964D\u4F4E\u4E86\u76EE\u6807\u626B\u63CF\u9891\u7387\uFF0C\u4F46\u4ECD\u4F1A\u6BCF\u6B21\u5237\u65B0\u6301\u7EED\u7275\u5F15\u3002"
      baseValue: "\u2022 Gravity wells scan for targets less often while still pulling
        every tick."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.24
      type: 13
      value: "\u2022 \u91CD\u53E0\u7684\u5F15\u529B\u4E95\u73B0\u5728\u4F1A\u5408\u5E76\u4E3A\u4E00\u4E2A\uFF0C\u5E76\u53E0\u52A0\u4F24\u5BB3\u3002"
      baseValue: "\u2022 Overlapping gravity wells now merge into a single well with
        stacked damage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.25
      type: 13
      value: "\u2022 \u8F89\u5149\u6355\u83B7\u73B0\u5728\u4F1A\u8DF3\u8FC7\u8239\u4F53\u3001\u5C0F\u884C\u661F\u548C\u5BB9\u5668\uFF0C\u7ED8\u5236\u8C03\u7528\u51CF\u534A\u3002"
      baseValue: "\u2022 Glow capture skips ship hulls, asteroids and containers,
        halving draw calls."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.26
      type: 13
      value: "\u2022 \u98DE\u8239\u8F6E\u5ED3\u6E32\u67D3\u73B0\u5728\u4F1A\u590D\u7528\u56FE\u5F62\u72B6\u6001\uFF0C\u800C\u4E0D\u662F\u9010\u4E2A\u90E8\u4EF6\u91CD\u7F6E\u3002"
      baseValue: "\u2022 Ship outline rendering reuses graphics state instead of
        resetting per part."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.27
      type: 13
      value: "\u2022 \u98DE\u8239\u4E0A\u7684\u6240\u6709\u81EA\u52A8\u6B66\u5668\u73B0\u5728\u5171\u7528\u4E00\u6B21\u76EE\u6807\u641C\u7D22\uFF0C\u800C\u4E0D\u662F\u5404\u81EA\u641C\u7D22\u3002"
      baseValue: "\u2022 All auto-weapons on a ship share one target search instead
        of one each."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.28
      type: 13
      value: "\u2022 \u5149\u675F\u62A4\u76FE\u68C0\u6D4B\u548C\u98DE\u8239\u5217\u8868\u7EF4\u62A4\u4E0D\u518D\u6BCF\u6B21\u5237\u65B0\u90FD\u5206\u914D\u5185\u5B58\u3002"
      baseValue: "\u2022 Beam shield checks and ship list upkeep no longer allocate
        memory each tick."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.29
      type: 13
      value: 
      baseValue: 
      context: 
