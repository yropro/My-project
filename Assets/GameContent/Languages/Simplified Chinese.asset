    - key: core.updateHistory.v0.7.96.1
      type: 13
      value: "\u2022 \u65B0\u589E\u661F\u4E91\u8D28\u91CF\u8BBE\u7F6E\uFF0C\u4E2D\u6863\u548C\u4F4E\u6863\u96FE\u6548\u8FD0\u884C\u66F4\u5FEB\uFF0C\u9002\u5408\u8001\u65E7\u7535\u8111\u3002"
      baseValue: "\u2022 New Nebula Quality setting offers faster Medium and Low
        fog for older PCs."
      context: 
      aiTranslated: 1
      keptEnglish: 0
