    - key: core.updateHistory.v0.7.91.44
      type: 13
      value: "\u2022 SceneGlowFeature.RegisterLine f\xFCgt der Leucht-Erfassung eigene
        Linien-Emitter hinzu."
      baseValue: "\u2022 SceneGlowFeature.RegisterLine adds custom line emitters
        to the glow capture."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.45
      type: 13
      value: "\u2022 Neue \xF6ffentliche Hilfsmethoden AIController.IsFormationSlaved
        und GravityWell.TryMerge."
      baseValue: "\u2022 New AIController.IsFormationSlaved and GravityWell.TryMerge
        public helpers."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.46
      type: 13
      value: "\u2022 SceneGlowFeature.ExcludeRenderer nimmt LDR-Sprites von der Leucht-Erfassung
        aus."
      baseValue: "\u2022 SceneGlowFeature.ExcludeRenderer opts LDR sprites out of
        the glow capture."
      context: 
