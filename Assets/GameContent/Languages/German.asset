      aiTranslated: 1
      keptEnglish: 0
    - key: oPuSchCr.completeDialog.3
      type: 2
      value: "Pflanzen? Ach ja, die Flora... wundersch\xF6n..."
      baseValue: Plants? Oh right, the Flora... lovely...
      context: 
      aiTranslated: 1
      keptEnglish: 0
