      keptEnglish: 1
    - key: core.updateHistory.v0.7.91.10
      type: 13
      value: "\u2022 Gegenst\xE4nde am Levellimit k\xF6nnen ihre Werte kostenlos
        neu berechnen, um Balance-\xC4nderungen zu \xFCbernehmen."
      baseValue: "\u2022 Level-capped items can Recalculate Stats for free to apply
        balance updates."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.11
      type: 13
      value: "\u2022 Das Eis des Eisfabrikators wirkt nun wie get\xF6ntes Glas statt
        wie blasses, flaches Eis."
      baseValue: "\u2022 Ice Fabricator ice now looks like tinted glass instead of
        pale, flat ice."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.12
      type: 13
      value: "\u2022 Flammen, Strahlen, Explosionen und Triebwerke werfen nun Licht
        auf nahe Objekte."
      baseValue: "\u2022 Flames, beams, explosions and engines now cast light onto
        nearby objects."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.13
      type: 13
      value: "\u2022 Neuer Grafikregler Dynamisches Leuchten passt den Lichtaustritt
        an; 0 deaktiviert ihn."
      baseValue: "\u2022 New Dynamic Glow graphics slider adjusts light spill; set
        to 0 to disable."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.14
      type: 13
      value: "\u2022 Triebwerke zeigen beim Platzieren von Slots einen Umriss, da
        sie unter der H\xFClle liegen."
      baseValue: "\u2022 Thrusters show a silhouette while placing slots as they
        hide under the hull."
      context: 
      aiTranslated: 1
      keptEnglish: 0
