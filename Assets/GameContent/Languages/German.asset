      aiTranslated: 0
      keptEnglish: 0
    - key: lcAfYiDp.arrivalDialog.1
      type: 2
      value: "Sind dir all die Aliens entgangen, gegen die wir die ganze Zeit k\xE4mpfen?"
      baseValue: Did you miss all the aliens we've been fighting?
