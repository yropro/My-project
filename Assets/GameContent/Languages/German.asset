      type: 13
      value: "\u2022 GravityCannon-Klassen, Category.LauncherGravity und den PullRadius-Wert
        hinzugef\xFCgt."
      baseValue: "\u2022 Added GravityCannon classes, Category.LauncherGravity and
        the PullRadius stat."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.61
      type: 13
      value: "\u2022 BlackHole.Init nimmt nun zwischengespeicherte Zuordnungs-Strings
        f\xFCr Waffe/Schiff/Fraktion entgegen."
      baseValue: "\u2022 BlackHole.Init now takes cached weapon/ship/faction attribution
        strings."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.62
      type: 13
      value: "\u2022 Projectile.GetParentLauncher()/CaptureDestroy() und ShipBody.ClearParts()
        hinzugef\xFCgt."
      baseValue: "\u2022 Added Projectile.GetParentLauncher()/CaptureDestroy(), ShipBody.ClearParts()."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.63
      type: 13
      value: "\u2022 Netz-Kataloge f\xFCr Asset-Namen und die Multiplayer-Nachricht
        CaptureGrant hinzugef\xFCgt."
      baseValue: "\u2022 Added net asset-name catalogs and the CaptureGrant multiplayer
        message."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.64
      type: 13
      value: "\u2022 ShipOutlineFeature.UnregisterRenderer() und RefreshRenderers()
        hinzugef\xFCgt."
      baseValue: "\u2022 Added ShipOutlineFeature.UnregisterRenderer() and RefreshRenderers()."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.65
      type: 13
      value: "\u2022 HangarDesign, Player.hangarDesigns und Pilot.SetUpgradeUnlocks()
        hinzugef\xFCgt."
      baseValue: "\u2022 Added HangarDesign, Player.hangarDesigns and Pilot.SetUpgradeUnlocks()."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.66
      type: 13
      value: "\u2022 Pilot.GetResetAllUpgradesCost() und GetResetSingleUpgradesCost()
        entfernt."
      baseValue: "\u2022 Removed Pilot.GetResetAllUpgradesCost() and GetResetSingleUpgradesCost()."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.67
      type: 13
      value: "\u2022 StarMapBase.fixedCaches, Star.AddFixedCache() und Cache.SetFixedItem()
        hinzugef\xFCgt."
      baseValue: "\u2022 Added StarMapBase.fixedCaches, Star.AddFixedCache() and
        Cache.SetFixedItem()."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.68
      type: 13
      value: "\u2022 StarDisplay.SetStar verliert showHidden; RewardDisplay erh\xE4lt
        InitMystery()."
      baseValue: "\u2022 StarDisplay.SetStar drops showHidden; RewardDisplay gains
        InitMystery()."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.69
      type: 13
      value: "\u2022 Ship.GetClassThreatMultiplier() und AIController.AddThreatToEngaged()
        hinzugef\xFCgt."
      baseValue: "\u2022 Added Ship.GetClassThreatMultiplier() and AIController.AddThreatToEngaged()."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.70
      type: 13
      value: "\u2022 StaticUpgrade erh\xE4lt threatPerSecond; neuer ItemStat.Type
        ThreatPerSecond."
      baseValue: "\u2022 StaticUpgrade gains threatPerSecond; new ItemStat.Type ThreatPerSecond."
      context: 
      aiTranslated: 1
      keptEnglish: 0
