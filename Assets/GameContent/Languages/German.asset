      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.30
      type: 13
      value: "\u2022 Die Gravitationskanone zeigt nun eine Fessel zu allem, was sie
        zieht, die mit der Entfernung verblasst."
      baseValue: "\u2022 Gravity Cannon now shows a tether to everything it pulls,
