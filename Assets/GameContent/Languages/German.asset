  - categoryName: Component.Death
    entries:
    - key: Death.regularDesc
      type: 8
      value: "Du bist gestorben und hast {0} Credits fallen gelassen. M\xF6chtest
        du respawnen?"
      baseValue: You have died and dropped {0} credit(s). Would you like to respawn?
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: Death.hardcoreDesc
      type: 8
      value: "Der Respawn ist f\xFCr Hardcore-Charaktere deaktiviert."
      baseValue: Respawn is disabled for hardcore players.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: Death.additionalSources
      type: 8
      value: "Aus {0} zus\xE4tzlichen Quellen..."
      baseValue: From {0} additional sources...
      context: 
