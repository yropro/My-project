      keptEnglish: 1
    - key: core.updateHistory.v0.7.91.6
      type: 13
      value: "\u2022 Schwierigkeitsvorgaben tauschen Schaden gegen z\xE4here Schiffe,
        mehr Feinde und mehr Bergung."
      baseValue: "\u2022 Difficulty presets trade damage for tougher ships, more
        enemies, more salvage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.7
      type: 13
      value: "\u2022 Eels bewegen sich nun 20 % langsamer."
      baseValue: "\u2022 Eels now move 20% slower."
