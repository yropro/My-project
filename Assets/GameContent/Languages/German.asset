      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.0
      type: 2
      value: "Effizient. Brutal. Ich wusste, du w\xFCrdest nicht scheitern."
      baseValue: Efficient. Brutal. I knew you wouldn't disappoint.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.1
      type: 2
      value: "Diese Komponente geh\xF6rte nie ihnen. Sie geh\xF6rte jenen, die vor
        ihnen hier waren."
      baseValue: This component was never theirs to begin with. It belonged to the
        ones who came before.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.2
      type: 2
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.3
      type: 2
      value: "Zaudere nicht. Es gibt noch mehr zu zerst\xF6ren... und mehr zu errichten."
      baseValue: Don't linger. There's more to break... and more to build.
      context: 
      aiTranslated: 0
      keptEnglish: 0
