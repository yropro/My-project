      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.22
      type: 13
      value: "\u2022 Kryofackel und Kinetische Leitung sind nun im Mutterschiff zum
        Kauf erh\xE4ltlich."
      baseValue: "\u2022 Cryo Torch and Kinetic Conduit are now available for sale
        in the mothership."
