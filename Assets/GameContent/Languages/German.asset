      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.23
      type: 13
      value: "\u2022 Geschwindigkeit von Mj\xF6lnirs Blitzkugel um 40 % erh\xF6ht."
      baseValue: "\u2022 Increased speed of Mj\xF6lnir's Lightning Orb by 40%."
