    - key: core.updateHistory.v0.8.05.0
      type: 13
      value: <color=#ffffff>New Features / Content</color>
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.05.1
      type: 13
      value: "\u2022 Unterst\xFCtzung f\xFCr traditionelles Chinesisch hinzugef\xFCgt."
      baseValue: "\u2022 Added Traditional Chinese language support."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.2
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.3
      type: 13
      value: <color=#ffffff>Quality of Life / Accessibility</color>
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.05.4
      type: 13
      value: "\u2022 Die Sprachliste zeigt den Namen jeder Sprache nun in Ihrer eigenen
        Sprache."
      baseValue: "\u2022 Language list now shows each language's name in your own
        language."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.5
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.6
      type: 13
      value: <color=#ffffff>Bug Fixes</color>
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.05.7
      type: 13
      value: "\u2022 Ausger\xFCstete Gegenst\xE4nde mit Abklingzeit werden beim Verschieben
        ins Lager nicht mehr dupliziert."
      baseValue: "\u2022 Equipped items on cooldown no longer duplicate when moved
        into storage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.8
      type: 13
      value: "\u2022 Fehler behoben, bei dem der Tod mit ge\xF6ffnetem Panel im Multiplayer
        das Schiff unsterblich machte."
      baseValue: "\u2022 Fixed dying with a panel open in multiplayer leaving the
        ship immortal."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.9
      type: 13
      value: "\u2022 Vom Fehler mit dem unsterblichen Schiff betroffene Speicherdateien
        werden nun beim n\xE4chsten Respawn repariert."
      baseValue: "\u2022 Saves affected by the immortal ship bug now recover on the
        next respawn."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.10
      type: 13
      value: "\u2022 Unbrauchbare zus\xE4tzliche Gateway-Chiffren aus dem Multiplayer
        werden nun automatisch entfernt."
      baseValue: "\u2022 Unusable extra Gateway Ciphers from multiplayer are now
        removed automatically."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.11
      type: 13
      value: "\u2022 Mehrere \xDCbersetzungsfehler im vereinfachten Chinesisch behoben."
      baseValue: "\u2022 Fixed a number of mistranslations in the Simplified Chinese
        text."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.0
      type: 13
      value: <color=#ffffff>Bug Fixes</color>
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.04.1
      type: 13
      value: "\u2022 Abdocken baut die H\xFCllenkollision nun neu auf, damit Schiffe
        ohne Schild Gegenst\xE4nde aufsammeln k\xF6nnen."
      baseValue: "\u2022 Undocking now rebuilds hull collision so shieldless ships
        can collect items."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.2
      type: 13
      value: "\u2022 Fehler behoben, wenn eine Koop-Begegnung mit einem \xFCbernommenen
        Schiff den Host wechselte."
      baseValue: "\u2022 Fixed an error taking over a co-op encounter holding a mind-controlled
        ship."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.3
      type: 13
      value: "\u2022 Fehler behoben, nachdem eine gespiegelte Strahlenwaffe in einen
        ungespiegelten Slot verschoben wurde."
      baseValue: "\u2022 Fixed an error after moving a mirrored beam weapon to an
        unmirrored slot."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.4
      type: 13
      value: "\u2022 Fehler behoben, wenn eine Drohne oder ein Gesch\xFCtzturm bei
        pausierter Zeit ein H\xFCllenteil verlor."
      baseValue: "\u2022 Fixed an error when a drone or turret lost a hull part while
        time was paused."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.5
      type: 13
      value: "\u2022 Fehler behoben, wenn man einer Sitzung beitrat, w\xE4hrend der
        Host eine Begegnung abschloss."
      baseValue: "\u2022 Fixed an error joining a session while the host completed
        an encounter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.0
      type: 13
      value: <color=#ffffff>Bug Fixes</color>
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.03.1
      type: 13
      value: "\u2022 Bei Koop-Host-\xDCbergaben landen Schiffe nach einer Invasion
        nicht mehr im falschen Geschwader."
      baseValue: "\u2022 Co-op host handoffs no longer put ships in the wrong squadron
        post-invasion."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.2
      type: 13
      value: "\u2022 Schiffsdesigns bemessen den Schild nun beim Fertigstellen, was
        einen Fehler bei schnellem Schlie\xDFen behebt."
      baseValue: "\u2022 Ship designs now size the shield on Finish, fixing an error
        when closed fast."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.3
      type: 13
      value: "\u2022 Eindringlinge breiten sich nicht mehr auf eine Begegnung aus,
        in die ein Koop-Spieler gerade springt."
      baseValue: "\u2022 Invaders no longer spread to an encounter a co-op player
        is jumping into."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.4
      type: 13
      value: "\u2022 Die Bildschirmtastatur schlie\xDFt nun mit ihrem Gegenstands-Panel,
        was einen Fehler bei Abbrechen behebt."
      baseValue: "\u2022 On-screen keyboard now closes with its item panel, fixing
        an error on Cancel."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.5
      type: 13
      value: "\u2022 Als Gegenstand gelagerte Credits k\xF6nnen nicht mehr weggeworfen
        oder abgeworfen werden."
      baseValue: "\u2022 Credits stored as an item can no longer be discarded or
        dropped."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.0
      type: 13
      value: <color=#ffffff>New Features / Content</color>
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.02.1
      type: 13
      value: "\u2022 Demo- und Vollversions-Spieler sehen nun gegenseitig ihre \u201ENur
        Steam-Freunde\u201C-Spiele."
      baseValue: "\u2022 Demo and full-game players can now see each other's Steam
        Friends Only games."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.2
      type: 13
      value: "\u2022 Spielen hinter einem geschlossenen Router-Port kann nun \xFCber
        die Spieleliste beigetreten werden."
      baseValue: "\u2022 Games behind a closed router port can now be joined from
        the game list."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.3
      type: 13
      value: "\u2022 Demo-Spiele verbinden sich nun \xFCber Steam, wenn beide Spieler
        die Demo besitzen."
      baseValue: "\u2022 Demo games now connect through Steam when both players own
        the demo."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.4
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.5
      type: 13
      value: <color=#ffffff>Quality of Life / Accessibility</color>
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.02.6
      type: 13
      value: "\u2022 Die spanische \xDCbersetzung wurde auf neutrales Spanisch f\xFCr
        Spanien und Lateinamerika \xFCberarbeitet."
      baseValue: "\u2022 Spanish translation revised to neutral Spanish for Spain
        and Latin America."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.7
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.8
      type: 13
      value: <color=#ffffff>Bug Fixes</color>
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.02.9
      type: 13
      value: "\u2022 Vor dem Laden des Men\xFCs angenommene Steam-Einladungen \xFCberspringen
        die Versionspr\xFCfung nicht mehr."
      baseValue: "\u2022 Steam invites accepted before the menu loads no longer skip
        the version check."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.10
      type: 13
      value: "\u2022 Gegnerische Geschwader verlieren kein Schiff mehr, wenn ein
        Koop-Spieler eine Begegnung verl\xE4sst."
      baseValue: "\u2022 Enemy squadrons no longer lose a ship when a co-op player
        leaves an encounter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.11
      type: 13
      value: "\u2022 \xDCber IPv6 gehostete \xF6ffentliche Spiele werden nun in der
        Spieleliste angezeigt, und man kann ihnen beitreten."
      baseValue: "\u2022 Public games hosted over IPv6 are now listed and joinable
        from the game list."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.12
      type: 13
      value: "\u2022 Ein Eingabefehler nach dem Verlassen eines Spiels mit noch \xF6ffnendem
        Schiffspanel wurde behoben."
      baseValue: "\u2022 Fixed an input error after leaving a game with a ship panel
        still opening."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.0
      type: 13
      value: <color=#ffffff>Quality of Life / Accessibility</color>
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.01.1
      type: 13
      value: "\u2022 Fehler bei Mod-Konflikten nennen nun die fehlenden, zus\xE4tzlichen
        oder falschen Mods."
      baseValue: "\u2022 Mod mismatch errors now name the missing, extra or wrong-version
        mods."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.2
      type: 13
      value: "\u2022 Tooltips in der Spieleliste zeigen nun die Mods des Hosts und
        markieren Abweichungen."
      baseValue: "\u2022 Game list tooltips now show the host's mods and flag any
        that differ."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.3
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.4
      type: 13
      value: <color=#ffffff>Performance</color>
      baseValue: <color=#ffffff>Performance</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.01.5
      type: 13
      value: "\u2022 Koop-Kampfdaten sind nun deutlich kleiner, was Spielern mit
        schwacher Verbindung hilft."
      baseValue: "\u2022 Co-op combat data is now far smaller, helping players on
        weaker connections."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.6
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.7
      type: 13
      value: <color=#ffffff>Bug Fixes</color>
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.01.8
      type: 13
      value: "\u2022 Steam-Spieler werden nicht mehr getrennt, wenn eine langsame
        Verbindung kurz stockt."
      baseValue: "\u2022 Steam players are no longer dropped when a slow connection
        briefly backs up."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.9
      type: 13
      value: "\u2022 Die Musik stottert in gro\xDFen K\xE4mpfen nicht mehr, da das
        Audio-Stimmenlimit zu niedrig war."
      baseValue: "\u2022 Music no longer stutters in big fights, as the audio voice
        limit was too low."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.10
      type: 13
      value: "\u2022 Entfernte Ger\xE4usche verstummen nun jenseits von 1,4 km, statt
        leise nachzuklingen."
      baseValue: "\u2022 Distant sounds now fade to silence beyond 1.4 km instead
        of lingering faintly."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.11
      type: 13
      value: "\u2022 Lautst\xE4rkeregler wirken nun schon beim Start und nicht erst
        nach dem ersten Speichern der Einstellungen."
      baseValue: "\u2022 Volume sliders now apply on launch instead of after the
        first settings save."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.12
      type: 13
      value: "\u2022 Gesch\xFCtzt\xFCrme von KI-Schiffen schwenken nun wieder nach
        vorn, sobald ihr Ziel weg ist."
      baseValue: "\u2022 AI ship turrets now swing back forward once their target
        is gone."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.13
      type: 13
      value: "\u2022 Die Gegneranzahl im Radar friert nicht mehr ein, wenn ein \xFCbernommenes
        Schiff einem Geschwader beitritt."
      baseValue: "\u2022 Radar enemy count no longer freezes when a converted ship
        joins a squadron."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.14
      type: 13
      value: "\u2022 Die Ankunft in der Begegnung eines Freundes l\xE4sst das eigene
        Schiff nicht mehr wei\xDF und bewegungsunf\xE4hig zur\xFCck."
      baseValue: "\u2022 Arriving in a friend's encounter no longer leaves your ship
        white and stuck."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.15
      type: 13
      value: "\u2022 Sch\xFCsse der Gravitationskanone explodieren nun am Ende ihres
        Fluges, statt einfach zu verschwinden."
      baseValue: "\u2022 Gravity Cannon shots now explode at the end of their flight,
        not just vanish."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.16
      type: 13
      value: "\u2022 Spr\xFCnge zwischen Begegnungen mit einem Vortex-Array verursachen
        keinen Fehler mehr."
      baseValue: "\u2022 Jumping between encounters with a Vortex Array no longer
        causes an error."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.title
      type: 13
      value: Multiplayer
      baseValue: Multiplayer
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.0.0
      type: 13
      value: <color=#ffffff>New Features / Content</color>
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.0.1
      type: 13
      value: "\u2022 Online mit Freunden spielen: Koop-Multiplayer f\xFCr bis zu
        8 Spieler."
      baseValue: "\u2022 Play online with friends: co-op multiplayer for up to 8
        players."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.2
      type: 13
      value: "\u2022 Gegner werden mit der Anzahl der Spieler in der Sitzung st\xE4rker."
      baseValue: "\u2022 Enemies scale in strength with the number of players in
        the session."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.3
      type: 13
      value: "\u2022 Erfahrung aus Absch\xFCssen wird mit Spielern in derselben Begegnung
        geteilt."
      baseValue: "\u2022 Experience from kills is shared with players in the same
        encounter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.4
      type: 13
      value: "\u2022 Sitzungen mit Name, optionalem Passwort, Spielerlimit und Sichtbarkeit
        hosten."
      baseValue: "\u2022 Host sessions with a name, optional password, player cap,
        and visibility."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.5
      type: 13
      value: "\u2022 Spiele \xFCber die \xF6ffentliche Spieleliste, LAN-Suche, Steam-Freunde
        oder IP finden."
      baseValue: "\u2022 Find games via the public game list, LAN discovery, Steam
        friends, or IP."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.6
      type: 13
      value: "\u2022 Eine Steam-Einladung annehmen und direkt in die Sitzung eines
        Freundes springen."
      baseValue: "\u2022 Accept a Steam invite to jump straight into a friend's session."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.7
      type: 13
      value: "\u2022 Spiele k\xF6nnen nach Wunsch auf PVP / Geteilte Beute gestellt
        werden."
      baseValue: "\u2022 Games can be set to PVP / Shared Loot as desired."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.8
      type: 13
      value: "\u2022 Hardcore- und Normal-Piloten k\xF6nnen in derselben Sitzung
        zusammenspielen."
      baseValue: "\u2022 Hardcore and Regular pilots can play together in the same
        session."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.9
      type: 13
      value: "\u2022 Neuer Text-Chat im HUD f\xFCr Multiplayer-Spiele, mit eigener
        Tastenzuweisung."
      baseValue: "\u2022 Text chat added to HUD in multiplayer games with new keybinding
        to activate."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.10
      type: 13
      value: "\u2022 Die Spielerliste neben dem Radar zeigt Status und Ort der anderen
        Spieler."
      baseValue: "\u2022 Player list next to Radar shows other players' status and
        location."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.11
      type: 13
      value: "\u2022 Trennt der Host die Verbindung, geht das Spiel nahtlos in den
        Einzelspieler \xFCber."
      baseValue: "\u2022 If the host disconnects the game seamlessly drops back into
        single player."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.12
      type: 13
      value: "\u2022 Die Demo enth\xE4lt vollen Multiplayer und kann in Sektor 1
        Vollversions-Sitzungen beitreten."
      baseValue: "\u2022 Demo includes full multiplayer and can join full-game sessions
        in Sector 1."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.13
      type: 13
      value: "\u2022 Dialoge im Multiplayer pausieren im Kampf nun die Begegnung
        f\xFCr alle."
      baseValue: "\u2022 Dialogs in multiplayer now pause the encounter for everyone
        during combat."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.14
      type: 13
      value: "\u2022 Multiplayer-Dialoge laufen per Lesezeit weiter, damit niemand
        blockiert bleibt."
      baseValue: "\u2022 Multiplayer dialogs auto-advance on a reading timer so no
        one stays frozen."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.15
      type: 13
      value: "\u2022 Die Spielerliste zeigt nun, welche Spieler gerade einen Dialog
        lesen."
      baseValue: "\u2022 Player list now shows which players are reading a dialog."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.16
      type: 13
      value: "\u2022 Neue Tooltips in der Multiplayer-Spieleliste zeigen Name, Level
        und Modus jedes Spielers."
      baseValue: "\u2022 New multiplayer game list tooltips show each player's name,
        level, and mode."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.17
      type: 13
      value: "\u2022 Hosts k\xF6nnen Spieler nun mit den Chat-Befehlen /kick und
        /ban entfernen oder sperren."
      baseValue: "\u2022 Hosts can now kick or ban players with the /kick and /ban
        chat commands."
