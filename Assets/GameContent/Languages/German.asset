      keptEnglish: 1
    - key: core.updateHistory.v0.7.91.1
      type: 13
      value: "\u2022 Neuer Schwierigkeitsregler \u201EFeinde\u201C skaliert die Anzahl
        feindlicher Geschwader von 50 % auf 200 %."
      baseValue: "\u2022 New Enemies difficulty slider scales enemy squadron numbers
        from 50% to 200%."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.2
      type: 13
      value: "\u2022 Neue Deko-Triebwerks-Slots f\xFCgen Schiffsdesigns kosmetische
        Richtungstriebwerke hinzu."
      baseValue: "\u2022 New Vanity Thruster slots add cosmetic directional thrusters
        to ship designs."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.3
      type: 13
      value: "\u2022 Neue Sekund\xE4rwaffe Reparaturstrahl repariert befreundete
        Schiffe."
      baseValue: "\u2022 New Repair Ray secondary weapon repairs friendly ships."
      context: 
      aiTranslated: 1
      keptEnglish: 0
