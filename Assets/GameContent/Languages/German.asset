      keptEnglish: 1
    - key: core.updateHistory.v0.7.91.31
      type: 13
      value: "\u2022 Die maximalen Modifikatorwerte im Glossar zeigen nun die h\xF6heren
        Grenzen f\xFCr Selten und Legend\xE4r."
      baseValue: "\u2022 Glossary max modifier values now reflect the higher Rare
        and Legendary caps."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.32
      type: 13
      value: "\u2022 Die Sternenkarten von Radar und Navigation widersprechen sich
        nicht mehr, welche Sterne Beute enthalten."
      baseValue: "\u2022 Radar and Navigation star maps no longer disagree on which
        stars hold loot."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.33
      type: 13
      value: "\u2022 Behoben, dass nach der Zerst\xF6rung eines \xFCbernommenen Geschwaderf\xFChrers
        ein Fehler auftrat."
      baseValue: "\u2022 Fixed an error after a mind-controlled squadron leader was
        destroyed."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.34
      type: 13
      value: "\u2022 Behoben, dass Tornado-Raketen beim Start durch tr\xE4ge Lenkd\xE4mpfung
        im Zickzack flogen."
      baseValue: "\u2022 Fixed Tornado missiles zigzagging at launch due to slow
        steering damping."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.35
      type: 13
      value: "\u2022 Point-Defense-Laser zielen nicht mehr auf harmlose Raketen abgereister
        Verb\xFCndeter."
      baseValue: "\u2022 Point Defense Lasers no longer target harmless missiles
        from departed allies."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.36
      type: 13
      value: "\u2022 R\xFCckg\xE4ngig stellt nach dem Laden einer Vorlage oder eines
        Imports nun Ihr vorheriges Schiff wieder her."
      baseValue: "\u2022 Undo after loading a template or import now restores your
        previous ship."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.37
      type: 13
      value: "\u2022 Die Teileliste im Ship Builder \xF6ffnet sich nicht mehr bereits
        ein St\xFCck weit gescrollt."
      baseValue: "\u2022 The Ship Builder parts list no longer opens scrolled partway
        along."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.38
      type: 13
      value: "\u2022 Die Controller-Auswahl w\xE4hlt keine aus dem Sichtbereich gescrollten
        Listeneintr\xE4ge mehr."
      baseValue: "\u2022 Controller selection no longer picks list items scrolled
        out of view."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.39
      type: 13
      value: "\u2022 Gravitationsfallen und Schwarze L\xF6cher schleudern Segmente
        von Schlangengegnern nicht mehr davon."
      baseValue: "\u2022 Gravity wells and black holes no longer send snake enemy
        segments flying."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.40
      type: 13
      value: "\u2022 Segmente von Schlangengegnern driften nicht mehr auseinander,
        wenn viele Schiffe im Gefecht sind."
      baseValue: "\u2022 Snake enemy segments no longer drift apart when many ships
        are in the fight."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.41
      type: 13
      value: "\u2022 Triebwerks-Slot-Ringe im Ship Builder liegen nun \xFCber der
        H\xFClle statt darunter."
      baseValue: "\u2022 Ship Builder thruster slot rings now show above the hull
        instead of under it."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.42
      type: 13
      value: 
      baseValue: 
