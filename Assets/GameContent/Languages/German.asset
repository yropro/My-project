      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.5
      type: 13
      value: "\u2022 Neue Sekund\xE4rwaffe: Die Gravitationskanone f\xE4ngt Tr\xFCmmer,
        Raketen und Drohnen ein."
      baseValue: "\u2022 New secondary weapon: the Gravity Cannon captures debris,
