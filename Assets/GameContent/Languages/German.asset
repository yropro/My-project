  - categoryName: Component.SettingsDataControl
    entries:
    - key: SettingsDataControl.cameraDistance.description
      type: 7
      value: Zoom-Distanz
      baseValue: Zoom Distance
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.cameraDistance.tooltip
      type: 8
      value: "Abstand der Kamera vom Schiff. Je h\xF6her der Wert, desto kleiner
        wird alles angezeigt."
      baseValue: Distance of camera from player, the larger the number the smaller
        everything will be.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.uiScale.description
      type: 7
      value: UI-Skalierung
      baseValue: UI Scale
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.uiScale.tooltip
      type: 8
      value: "Gr\xF6\xDFe des Interfaces im Spiel."
      baseValue: Scale of the user interface around the game.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.hudScale.description
      type: 7
      value: HUD-Skalierung
      baseValue: HUD Scale
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.hudScale.tooltip
      type: 8
      value: "Gr\xF6\xDFe des HUDs im Spiel."
      baseValue: Scale of the heads-up display in game.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.minibarScale.description
      type: 7
      value: Minileisten-Skalierung
      baseValue: Minibar Scale
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.minibarScale.tooltip
      type: 8
      value: "Gr\xF6\xDFe der unter dem Schiff angezeigten Minileisten (Schild, H\xFClle
        usw.)."
      baseValue: Scale of the minibars (shield / hull / etc) displayed below ships.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.floatingDamageScale.description
      type: 7
      value: Schadenszahl-Skalierung
      baseValue: Damage Number Scale
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.floatingDamageScale.tooltip
      type: 8
      value: "Gr\xF6\xDFe der schwebenden Schadenszahlen \xFCber Gegnern. Ein Wert
        von 0% deaktiviert diese komplett."
      baseValue: Set the scale of floating damage numbers above enemy ships. Setting
        to 0% will disable them entirely.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.cameraShake.description
      type: 7
      value: Kamerawackler
      baseValue: Camera Shake
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.cameraShake.tooltip
      type: 8
      value: "L\xE4sst die Kamera wackeln, wenn Sie Schaden erleiden oder schwere
        Waffen abfeuern."
      baseValue: Shake the camera when taking damage or firing heavy weapons.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.showWarningGlow.description
      type: 7
      value: Warnungsleuchten anzeigen
      baseValue: Show Warning Glow
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.showWarningGlow.tooltip
      type: 8
      value: "Zeigt ein Gl\xFChen am Bildschirmrand wenn die Schilde unten sind und
        du wenig H\xFCllenst\xE4rke hast."
      baseValue: Shows a glow around the edge of the screen when your shield goes
        down or you are on low health.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.smallShipBar.description
      type: 7
      value: Kleine Schiffsleiste
      baseValue: Small Ship Bar
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.smallShipBar.tooltip
      type: 8
      value: "Verkleinert die Schiffsleiste am unteren Rand des HUD f\xFCr mehr vertikale
        Sicht."
      baseValue: Shrink down the ship bar at the bottom of the HUD for more vertical
        visibility.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.playerBars.description
      type: 7
      value: Spieler-Minileiste anzeigen
      baseValue: Show Player Minibars
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.playerBars.tooltip
      type: 8
      value: "Zeigt Minibars unter dem Spielerschiff an, damit Sie Schild und H\xFClle
        leichter verfolgen k\xF6nnen."
      baseValue: Shows minibars below the player ship so you can more easily track
        your shield / hull.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.radialOpacity.description
      type: 7
      value: Transparenz der Radialanzeige
      baseValue: Radial Display Opacity
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.radialOpacity.tooltip
      type: 8
      value: "Schild, H\xFClle und Hitze werden kreisf\xF6rmig um Ihr Schiff angezeigt.
        Durch Anpassen der Deckkraft werden sie mehr oder weniger sichtbar; bei 0
        % werden sie vollst\xE4ndig deaktiviert."
      baseValue: Shield, hull and heat are displayed around your ship in a circle.
        Adjusting their opacity will make them more or less visible, setting to 0%
        will disable it entirely.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.description
      type: 7
      value: "Verbrauchsgegenst\xE4nde ignorieren"
      baseValue: Ignore Consumables
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.tooltip
      type: 8
      value: "Legen Sie fest, wann Sie Verbrauchsg\xFCter per Traktorstrahl einsammeln
        und aufnehmen.\nNiemals = Alle Verbrauchsg\xFCter einsammeln\nClever = Vorhandene
        Stapel auff\xFCllen und mindestens einen Stapel zugewiesener Verbrauchsg\xFCter
        behalten\nImmer = Keine Verbrauchsg\xFCter einsammeln"
      baseValue: 'Set when you will tractor and pick up consumables.

        Never
        = Collect all consumables

        Smart = Fill existing stacks and keep
        at least one stack of assigned consumables

        Always = Do not collect
        any consumables'
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.value.0
      type: 7
      value: Nie
      baseValue: Never
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.value.1
      type: 7
      value: Intelligent
      baseValue: Smart
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.value.2
      type: 7
      value: Immer
      baseValue: Always
      context: 
