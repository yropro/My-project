    - key: core.updateHistory.v0.7.91.16
      type: 13
      value: <color=#ffffff>Performance</color>
      baseValue: <color=#ffffff>Performance</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.7.91.17
      type: 13
      value: "\u2022 Die Physik holt nun h\xF6chstens 3 Schritte pro Frame auf, um
        Ruckler in gro\xDFen Gefechten zu verhindern."
      baseValue: "\u2022 Physics now catches up at most 3 steps per frame to stop
        heavy-battle stutter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.18
      type: 13
      value: "\u2022 Schiffswert-Abfragen durchsuchen nicht mehr die gesamte Ausr\xFCstung,
        was gro\xDFe Loadouts beschleunigt."
      baseValue: "\u2022 Ship stat lookups no longer rescan all equipment, speeding
        up big loadouts."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.19
      type: 13
      value: "\u2022 Schaden von Brennend, Radioaktiv und Durchbohrt tickt in Gruppen
        und senkt so die CPU-Last."
      baseValue: "\u2022 Burning, Radioactive and Impaled damage ticks in batches
        to cut CPU load."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.20
      type: 13
      value: "\u2022 Auto-Waffen nutzen ihre Schusslinien-Pr\xFCfung kurz weiter,
        statt sie jeden Tick zu wiederholen."
      baseValue: "\u2022 Auto-weapons reuse their line-of-fire check briefly instead
        of every tick."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.21
      type: 13
      value: "\u2022 Schiffs-Lebensbalken und Statussymbole werden nun wiederverwendet
        statt jedes Mal neu erstellt."
      baseValue: "\u2022 Ship health bars and status icons are reused instead of
        rebuilt each time."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.22
      type: 13
      value: "\u2022 Leech-Samen sind nun auf 30 gleichzeitig pro Schiff begrenzt;
        \xFCberz\xE4hliger Entzug heilt sofort."
      baseValue: "\u2022 Leech seeds now cap at 30 in flight per ship; extra leech
        heals instantly."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.23
      type: 13
      value: "\u2022 Gravitationsfallen suchen seltener nach Zielen, ziehen aber
        weiterhin jeden Tick."
      baseValue: "\u2022 Gravity wells scan for targets less often while still pulling
        every tick."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.24
      type: 13
      value: "\u2022 \xDCberlappende Gravitationsfallen verschmelzen nun zu einer
        Falle mit summiertem Schaden."
      baseValue: "\u2022 Overlapping gravity wells now merge into a single well with
        stacked damage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.25
      type: 13
      value: "\u2022 Die Leucht-Erfassung \xFCberspringt Schiffsh\xFCllen, Asteroiden
        und Container und halbiert die Draw Calls."
      baseValue: "\u2022 Glow capture skips ship hulls, asteroids and containers,
        halving draw calls."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.26
      type: 13
      value: "\u2022 Die Darstellung von Schiffsumrissen nutzt den Grafikzustand
        weiter, statt ihn je Teil zur\xFCckzusetzen."
      baseValue: "\u2022 Ship outline rendering reuses graphics state instead of
        resetting per part."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.27
      type: 13
      value: "\u2022 Alle Auto-Waffen eines Schiffs teilen sich nun eine Zielsuche
        statt je einer eigenen."
      baseValue: "\u2022 All auto-weapons on a ship share one target search instead
        of one each."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.28
      type: 13
      value: "\u2022 Strahl-Schildpr\xFCfungen und die Pflege der Schiffsliste belegen
        nicht mehr jeden Tick Speicher."
      baseValue: "\u2022 Beam shield checks and ship list upkeep no longer allocate
        memory each tick."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.29
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
