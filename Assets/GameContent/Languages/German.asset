      keptEnglish: 1
    - key: core.updateHistory.v0.7.95.1
      type: 13
      value: "\u2022 Der neue Hangar am Assembler speichert bis zu 10 Schiffsdesigns
        zum Wechseln."
      baseValue: "\u2022 New Assembler Hangar Bay stores up to 10 ship designs you
        can switch between."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.2
      type: 13
      value: "\u2022 Das Zur\xFCcksetzen von Upgrades kostet keine Credits mehr,
        also ruhig experimentieren."
      baseValue: "\u2022 Resetting upgrades no longer costs credits, so feel free
        to experiment."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.3
      type: 13
      value: "\u2022 Credits lassen sich nun am Assembler in das Lokale und das Geteilte
        Lager einzahlen."
      baseValue: "\u2022 Credits can now be deposited into Local and Shared Vaults
        at the Assembler."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.4
      type: 13
      value: "\u2022 Sektoren enthalten nun feste Beh\xE4lter mit vorgegebenen seltenen
        Gegenst\xE4nden."
      baseValue: "\u2022 Sectors now include fixed caches that drop pre-defined rare
