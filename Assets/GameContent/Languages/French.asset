    - key: SettingsDataControl.multiplayerColors.description
      type: 7
      value: Couleurs multijoueur
      baseValue: Multiplayer Colors
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.multiplayerColors.tooltip
      type: 8
      value: "Affiche la couleur attribu\xE9e \xE0 chaque joueur sous forme de contour
        autour de son vaisseau dans les sessions multijoueur."
      baseValue: Show each player's assigned color as an outline around their ship
        in multiplayer sessions.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.showShields.description
      type: 7
      value: Boucliers visibles
      baseValue: Visible Shields
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.showShields.tooltip
      type: 8
      value: Rend tous les boucliers de vaisseau partiellement visibles lorsqu'ils
        sont actifs.
      baseValue: Makes all ship shields partially visible when active.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.resolution.description
      type: 7
      value: "R\xE9solution"
      baseValue: Resolution
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.resolution.tooltip
      type: 8
      value: "R\xE9solution d'affichage dans laquelle le jeu tournera."
      baseValue: Display resolution that the game will run in.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.fullScreen.description
      type: 7
      value: "Plein \xE9cran"
      baseValue: Fullscreen
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.fullScreen.tooltip
      type: 8
      value: "D\xE9finit si le jeu doit s'ex\xE9cuter en plein \xE9cran ou dans un
        type de fen\xEAtre."
      baseValue: Set whether the game should run in fullscreen or a type of window.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.fullScreen.value.0
      type: 7
      value: "Plein \xE9cran (Exclusif)"
      baseValue: Fullscreen (Exclusive)
