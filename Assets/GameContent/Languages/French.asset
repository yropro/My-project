    - key: SettingsDataControl.quality.value.2
      type: 7
      value: Bonne
      baseValue: Good
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.quality.value.3
      type: 7
      value: Simple
      baseValue: Simple
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.quality.value.4
