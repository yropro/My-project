  - categoryName: Component.Death
    entries:
    - key: Death.regularDesc
      type: 8
      value: "Vous \xEAtes mort et avez perdu {0} cr\xE9dit(s). Souhaitez-vous r\xE9appara\xEEtre\_?"
      baseValue: You have died and dropped {0} credit(s). Would you like to respawn?
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: Death.hardcoreDesc
      type: 8
      value: "La r\xE9apparition est d\xE9sactiv\xE9e pour les joueurs hardcore."
