      aiTranslated: 1
      keptEnglish: 0
    - key: ZIZW21Vn.arrivalDialog.1
      type: 2
      value: "C'est rouge, ESA. Depuis quand le rouge signifie-t-il \xAB\_bien\_\xBB\_?"
      baseValue: It's red, ESA. When has red ever meant 'good'?
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: ZIZW21Vn.arrivalDialog.2
      type: 2
      value: "La salsa est rouge. Les fajitas ont besoin de salsa. J'en reste l\xE0."
      baseValue: Salsa is red. Fajitas need salsa. I rest my case.
