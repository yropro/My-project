      keptEnglish: 0
    - key: core.updateHistory.v0.7.92.19
      type: 13
      value: "\u2022 Correction d'une erreur quand un rayon laser touchait une cible
        apr\xE8s la destruction de son vaisseau."
      baseValue: "\u2022 Fixed an error when a laser beam hit a target after its
        ship was destroyed."
