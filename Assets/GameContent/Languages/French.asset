      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.hudParticles.description
      type: 7
      value: Particules de collection
      baseValue: Collection Particles
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.hudParticles.tooltip
