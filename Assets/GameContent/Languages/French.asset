      keptEnglish: 0
    - key: core.updateHistory.v0.7.92.20
      type: 13
      value: "\u2022 Les trous noirs continuent d'infliger des d\xE9g\xE2ts apr\xE8s
        la destruction de leur tireur."
      baseValue: "\u2022 Black holes no longer stop dealing damage when the ship
        that fired them dies."
