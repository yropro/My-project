      type: 13
      value: "\u2022 Ajout de HangarDesign, Player.hangarDesigns et Pilot.SetUpgradeUnlocks()."
      baseValue: "\u2022 Added HangarDesign, Player.hangarDesigns and Pilot.SetUpgradeUnlocks()."
