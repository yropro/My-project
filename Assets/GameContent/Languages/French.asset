      type: 13
      value: "\u2022 Suppression de Pilot.GetResetAllUpgradesCost() et GetResetSingleUpgradesCost()."
      baseValue: "\u2022 Removed Pilot.GetResetAllUpgradesCost() and GetResetSingleUpgradesCost()."
