      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.13
      type: 13
      value: "\u2022 Le Rayon de r\xE9paration peut d\xE9sormais r\xE9parer vos propres
        drones et tourelles s'il les vise."
      baseValue: "\u2022 Repair Ray can now repair your own drones and turrets when
