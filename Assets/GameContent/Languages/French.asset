    - key: SettingsDataControl.refreshRate.description
      type: 7
      value: "Taux de rafra\xEEchissement"
      baseValue: Refresh Rate
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.refreshRate.tooltip
      type: 8
      value: "Taux de rafra\xEEchissement d'affichage auquel le jeu tournera. Mode
        plein \xE9cran (exclusif) uniquement."
      baseValue: Display refresh rate that the game to run in. Fullscreen (Exclusive)
        mode only.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.brightness.description
      type: 7
      value: "Luminosit\xE9"
      baseValue: Brightness
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.brightness.tooltip
      type: 8
      value: "Ajuste la luminosit\xE9 globale du jeu."
      baseValue: Adjusts the overall brightness of the game.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.maxQueuedFrames.description
      type: 7
      value: "Nombre maximal d'images pr\xE9-rendues"
      baseValue: Maximum Pre-rendered Frames
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.maxQueuedFrames.tooltip
      type: 8
      value: "Nombre maximum d'images pr\xE9-rendues. Une valeur plus faible rend
        les commandes plus r\xE9actives mais peut diminuer les performances."
      baseValue: Maximum number of pre-rendered frames. A lower value will make controls
        feel more responsive but may decrease performance.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.quality.description
      type: 7
      value: "Qualit\xE9 g\xE9n\xE9rale"
      baseValue: Overall Quality
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.quality.tooltip
      type: 8
      value: "Qualit\xE9 graphique globale\_; d'autres param\xE8tres individuels
        peuvent \xEAtre ajust\xE9s ci-dessous."
      baseValue: Overall graphical quality, further individual settings can be fine
        tuned below.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.quality.value.0
      type: 7
      value: Fantastique
      baseValue: Fantastic
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.quality.value.1
