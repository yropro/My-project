      type: 8
      value: "Ajuste la quantit\xE9 de particules \xE9mises par les syst\xE8mes de
        particules."
      baseValue: Scales the amount of particles given off by particle systems.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.particleQuality.value.0
      type: 7
      value: Max.
      baseValue: Maximum
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.particleQuality.value.1
      type: 7
      value: "\xC9lev\xE9e"
      baseValue: High
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.particleQuality.value.2
      type: 7
      value: Moyenne
      baseValue: Medium
