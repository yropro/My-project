      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.22
      type: 13
      value: "\u2022 Les dossiers de pr\xE9r\xE9glages du concepteur de vaisseaux
        sont d\xE9sormais tri\xE9s par ordre alphab\xE9tique dans votre langue."
      baseValue: "\u2022 Ship designer preset folders now sort alphabetically in
        your language."
