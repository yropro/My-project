    - key: core.updateHistory.v0.7.91.44
      type: 13
      value: "\u2022 SceneGlowFeature.RegisterLine ajoute des \xE9metteurs de ligne
        \xE0 la capture de lueur."
      baseValue: "\u2022 SceneGlowFeature.RegisterLine adds custom line emitters
        to the glow capture."
      context: 
