      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.20
      type: 13
      value: "\u2022 Les pages d'objets du Glossaire indiquent d\xE9sormais quelle
        faction d\xE9tient une cache fixe de cet objet."
      baseValue: "\u2022 Glossary item pages now list which faction holds a fixed
        cache for the item."
