      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.63
      type: 13
      value: "\u2022 Les m\xE9thodes Overwrite/Revert de mat\xE9riau et de couleur
        d'Equippable sont d\xE9sormais virtual."
      baseValue: "\u2022 Equippable material and color Overwrite/Revert methods are
