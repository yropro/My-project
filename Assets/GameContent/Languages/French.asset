      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.68
      type: 13
      value: "\u2022 StarDisplay.SetStar abandonne showHidden, et RewardDisplay gagne
        InitMystery()."
      baseValue: "\u2022 StarDisplay.SetStar drops showHidden; RewardDisplay gains
        InitMystery()."
      context: 
