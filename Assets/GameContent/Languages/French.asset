    - key: core.updateHistory.v0.8.05.0
      type: 13
      value: "<color=#ffffff>Nouveaut\xE9s / Contenu</color>"
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.1
      type: 13
      value: "\u2022 Prise en charge du chinois traditionnel ajout\xE9e."
      baseValue: "\u2022 Added Traditional Chinese language support."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.2
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.3
      type: 13
      value: "<color=#ffffff>Confort de jeu / Accessibilit\xE9</color>"
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.4
      type: 13
      value: "\u2022 La liste des langues affiche d\xE9sormais le nom de chacune
        dans votre propre langue."
      baseValue: "\u2022 Language list now shows each language's name in your own
        language."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.5
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.6
      type: 13
      value: <color=#ffffff>Corrections de bugs</color>
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.7
      type: 13
      value: "\u2022 Les objets \xE9quip\xE9s en recharge ne se dupliquent plus lorsqu'ils
        sont d\xE9plac\xE9s vers le stockage."
      baseValue: "\u2022 Equipped items on cooldown no longer duplicate when moved
        into storage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.8
      type: 13
      value: "\u2022 Correction de la mort avec un panneau ouvert en multijoueur
        qui rendait le vaisseau immortel."
      baseValue: "\u2022 Fixed dying with a panel open in multiplayer leaving the
        ship immortal."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.9
      type: 13
      value: "\u2022 Les sauvegardes touch\xE9es par le bug du vaisseau immortel
        se r\xE9tablissent d\xE9sormais \xE0 la r\xE9apparition suivante."
      baseValue: "\u2022 Saves affected by the immortal ship bug now recover on the
        next respawn."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.10
      type: 13
      value: "\u2022 Les Cl\xE9s de portail en trop et inutilisables issues du multijoueur
        sont d\xE9sormais retir\xE9es automatiquement."
      baseValue: "\u2022 Unusable extra Gateway Ciphers from multiplayer are now
        removed automatically."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.11
      type: 13
      value: "\u2022 Correction de plusieurs erreurs de traduction dans le texte
        en chinois simplifi\xE9."
      baseValue: "\u2022 Fixed a number of mistranslations in the Simplified Chinese
        text."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.0
      type: 13
      value: <color=#ffffff>Corrections de bugs</color>
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.1
      type: 13
      value: "\u2022 Le d\xE9samarrage reconstruit d\xE9sormais la collision de la
        coque pour que les vaisseaux sans bouclier puissent ramasser des objets."
      baseValue: "\u2022 Undocking now rebuilds hull collision so shieldless ships
        can collect items."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.2
      type: 13
      value: "\u2022 Correction d'une erreur lors de la reprise d'une rencontre en
        coop\xE9ratif contenant un vaisseau sous contr\xF4le mental."
      baseValue: "\u2022 Fixed an error taking over a co-op encounter holding a mind-controlled
        ship."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.3
      type: 13
      value: "\u2022 Correction d'une erreur apr\xE8s le d\xE9placement d'une arme
        \xE0 rayon en miroir vers un slot sans miroir."
      baseValue: "\u2022 Fixed an error after moving a mirrored beam weapon to an
        unmirrored slot."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.4
      type: 13
      value: "\u2022 Correction d'une erreur quand un drone ou une tourelle perdait
        une pi\xE8ce de coque alors que le temps \xE9tait en pause."
      baseValue: "\u2022 Fixed an error when a drone or turret lost a hull part while
        time was paused."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.5
      type: 13
      value: "\u2022 Correction d'une erreur en rejoignant une session pendant que
        l'h\xF4te terminait une rencontre."
      baseValue: "\u2022 Fixed an error joining a session while the host completed
        an encounter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.0
      type: 13
      value: <color=#ffffff>Corrections de bugs</color>
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.1
      type: 13
      value: "\u2022 Les transferts d'h\xF4te en coop\xE9ratif ne placent plus les
        vaisseaux dans le mauvais escadron apr\xE8s une invasion."
      baseValue: "\u2022 Co-op host handoffs no longer put ships in the wrong squadron
        post-invasion."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.2
      type: 13
      value: "\u2022 Les concepts de vaisseau dimensionnent d\xE9sormais le bouclier
        \xE0 la validation, corrigeant une erreur en cas de fermeture rapide."
      baseValue: "\u2022 Ship designs now size the shield on Finish, fixing an error
        when closed fast."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.3
      type: 13
      value: "\u2022 Les envahisseurs ne se propagent plus dans une rencontre o\xF9
        un joueur en coop\xE9ratif effectue un hypersaut."
      baseValue: "\u2022 Invaders no longer spread to an encounter a co-op player
        is jumping into."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.4
      type: 13
      value: "\u2022 Le clavier virtuel se ferme d\xE9sormais avec son panneau d'objet,
        corrigeant une erreur lors de l'annulation."
      baseValue: "\u2022 On-screen keyboard now closes with its item panel, fixing
        an error on Cancel."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.03.5
      type: 13
      value: "\u2022 Les cr\xE9dits stock\xE9s sous forme d'objet ne peuvent plus
        \xEAtre jet\xE9s."
      baseValue: "\u2022 Credits stored as an item can no longer be discarded or
        dropped."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.0
      type: 13
      value: "<color=#ffffff>Nouveaut\xE9s / Contenu</color>"
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.1
      type: 13
      value: "\u2022 Les joueurs de la d\xE9mo et du jeu complet voient d\xE9sormais
        mutuellement leurs parties Amis Steam uniquement."
      baseValue: "\u2022 Demo and full-game players can now see each other's Steam
        Friends Only games."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.2
      type: 13
      value: "\u2022 Les parties dont le port du routeur est ferm\xE9 peuvent d\xE9sormais
        \xEAtre rejointes depuis la liste des parties."
      baseValue: "\u2022 Games behind a closed router port can now be joined from
        the game list."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.3
      type: 13
      value: "\u2022 Les parties de la d\xE9mo se connectent d\xE9sormais via Steam
        si les deux joueurs poss\xE8dent la d\xE9mo."
      baseValue: "\u2022 Demo games now connect through Steam when both players own
        the demo."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.4
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.5
      type: 13
      value: "<color=#ffffff>Confort de jeu / Accessibilit\xE9</color>"
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.6
      type: 13
      value: "\u2022 La traduction espagnole a \xE9t\xE9 revue en espagnol neutre
        pour l'Espagne et l'Am\xE9rique latine."
      baseValue: "\u2022 Spanish translation revised to neutral Spanish for Spain
        and Latin America."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.7
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.8
      type: 13
      value: <color=#ffffff>Corrections de bugs</color>
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.9
      type: 13
      value: "\u2022 Les invitations Steam accept\xE9es avant le chargement du menu
        ne sautent plus la v\xE9rification de version."
      baseValue: "\u2022 Steam invites accepted before the menu loads no longer skip
        the version check."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.10
      type: 13
      value: "\u2022 Les escadrons ennemis ne perdent plus de vaisseau quand un joueur
        en coop\xE9ratif quitte une rencontre."
      baseValue: "\u2022 Enemy squadrons no longer lose a ship when a co-op player
        leaves an encounter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.11
      type: 13
      value: "\u2022 Les parties publiques h\xE9berg\xE9es en IPv6 sont d\xE9sormais
        r\xE9pertori\xE9es et peuvent \xEAtre rejointes depuis la liste des parties."
      baseValue: "\u2022 Public games hosted over IPv6 are now listed and joinable
        from the game list."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.02.12
      type: 13
      value: "\u2022 Correction d'une erreur d'entr\xE9e apr\xE8s avoir quitt\xE9
        une partie pendant l'ouverture d'un panneau de vaisseau."
      baseValue: "\u2022 Fixed an input error after leaving a game with a ship panel
        still opening."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.0
      type: 13
      value: "<color=#ffffff>Confort de jeu / Accessibilit\xE9</color>"
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.1
      type: 13
      value: "\u2022 Les erreurs de mods nomment d\xE9sormais les mods manquants,
        en trop ou de mauvaise version."
      baseValue: "\u2022 Mod mismatch errors now name the missing, extra or wrong-version
        mods."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.2
      type: 13
      value: "\u2022 Les infobulles de la liste des parties affichent d\xE9sormais
        les mods de l'h\xF4te et signalent les diff\xE9rences."
      baseValue: "\u2022 Game list tooltips now show the host's mods and flag any
        that differ."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.3
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.4
      type: 13
      value: <color=#ffffff>Performance</color>
      baseValue: <color=#ffffff>Performance</color>
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: core.updateHistory.v0.8.01.5
      type: 13
      value: "\u2022 Les donn\xE9es de combat en coop\xE9ratif sont bien plus l\xE9g\xE8res,
        aidant les joueurs \xE0 faible connexion."
      baseValue: "\u2022 Co-op combat data is now far smaller, helping players on
        weaker connections."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.6
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.7
      type: 13
      value: <color=#ffffff>Corrections de bugs</color>
      baseValue: <color=#ffffff>Bug Fixes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.8
      type: 13
      value: "\u2022 Les joueurs Steam ne sont plus d\xE9connect\xE9s lors d'un bref
        engorgement de la connexion."
      baseValue: "\u2022 Steam players are no longer dropped when a slow connection
        briefly backs up."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.9
      type: 13
      value: "\u2022 La musique ne saccade plus dans les gros combats\_: la limite
        de voix audio \xE9tait trop basse."
      baseValue: "\u2022 Music no longer stutters in big fights, as the audio voice
        limit was too low."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.10
      type: 13
      value: "\u2022 Les sons lointains s'\xE9teignent compl\xE8tement au-del\xE0
        de 1,4\_km au lieu de persister faiblement."
      baseValue: "\u2022 Distant sounds now fade to silence beyond 1.4 km instead
        of lingering faintly."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.11
      type: 13
      value: "\u2022 Les curseurs de volume s'appliquent au lancement, et non apr\xE8s
        le premier enregistrement des param\xE8tres."
      baseValue: "\u2022 Volume sliders now apply on launch instead of after the
        first settings save."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.12
      type: 13
      value: "\u2022 Les tourelles des vaisseaux IA reviennent vers l'avant une fois
        leur cible disparue."
      baseValue: "\u2022 AI ship turrets now swing back forward once their target
        is gone."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.13
      type: 13
      value: "\u2022 Le nombre d'ennemis du Radar ne se fige plus quand un vaisseau
        converti rejoint un escadron."
      baseValue: "\u2022 Radar enemy count no longer freezes when a converted ship
        joins a squadron."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.14
      type: 13
      value: "\u2022 Arriver dans la rencontre d'un ami ne laisse plus votre vaisseau
        blanc et bloqu\xE9."
      baseValue: "\u2022 Arriving in a friend's encounter no longer leaves your ship
        white and stuck."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.15
      type: 13
      value: "\u2022 Les tirs du Canon gravitationnel explosent en fin de course
        au lieu de simplement dispara\xEEtre."
      baseValue: "\u2022 Gravity Cannon shots now explode at the end of their flight,
        not just vanish."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.16
      type: 13
      value: "\u2022 Passer d'une rencontre \xE0 l'autre avec un R\xE9seau Vortex
        ne provoque plus d'erreur."
      baseValue: "\u2022 Jumping between encounters with a Vortex Array no longer
        causes an error."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.title
      type: 13
      value: Multijoueur
      baseValue: Multiplayer
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.0
      type: 13
      value: "<color=#ffffff>Nouveaut\xE9s / Contenu</color>"
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.1
      type: 13
      value: "\u2022 Jouez en ligne entre amis\_: multijoueur coop\xE9ratif jusqu'\xE0
        8 joueurs."
      baseValue: "\u2022 Play online with friends: co-op multiplayer for up to 8
        players."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.2
      type: 13
      value: "\u2022 La puissance des ennemis augmente avec le nombre de joueurs
        dans la session."
      baseValue: "\u2022 Enemies scale in strength with the number of players in
        the session."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.3
      type: 13
      value: "\u2022 L'exp\xE9rience des \xE9liminations est partag\xE9e avec les
        joueurs de la m\xEAme rencontre."
      baseValue: "\u2022 Experience from kills is shared with players in the same
        encounter."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.4
      type: 13
      value: "\u2022 H\xE9bergez des sessions avec nom, mot de passe optionnel, limite
        de joueurs et visibilit\xE9."
      baseValue: "\u2022 Host sessions with a name, optional password, player cap,
        and visibility."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.5
      type: 13
      value: "\u2022 Trouvez des parties via la liste publique, la d\xE9tection LAN,
        les amis Steam ou l'IP."
      baseValue: "\u2022 Find games via the public game list, LAN discovery, Steam
        friends, or IP."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.6
      type: 13
      value: "\u2022 Acceptez une invitation Steam pour rejoindre directement la
        session d'un ami."
      baseValue: "\u2022 Accept a Steam invite to jump straight into a friend's session."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.7
      type: 13
      value: "\u2022 Les parties peuvent \xEAtre r\xE9gl\xE9es sur PVP / Butin partag\xE9
        selon vos envies."
      baseValue: "\u2022 Games can be set to PVP / Shared Loot as desired."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.8
      type: 13
      value: "\u2022 Les pilotes Hardcore et Normal peuvent jouer ensemble dans la
        m\xEAme session."
      baseValue: "\u2022 Hardcore and Regular pilots can play together in the same
        session."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.9
      type: 13
      value: "\u2022 Chat textuel ajout\xE9 \xE0 l'ATH en multijoueur, avec un nouveau
        raccourci pour l'activer."
      baseValue: "\u2022 Text chat added to HUD in multiplayer games with new keybinding
        to activate."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.10
      type: 13
      value: "\u2022 La liste des joueurs pr\xE8s du Radar affiche l'\xE9tat et la
        position des autres joueurs."
      baseValue: "\u2022 Player list next to Radar shows other players' status and
        location."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.11
      type: 13
      value: "\u2022 Si l'h\xF4te se d\xE9connecte, la partie bascule sans coupure
        en jeu solo."
      baseValue: "\u2022 If the host disconnects the game seamlessly drops back into
        single player."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.12
      type: 13
      value: "\u2022 La d\xE9mo inclut tout le multijoueur et peut rejoindre des
        sessions du jeu complet dans le Secteur 1."
      baseValue: "\u2022 Demo includes full multiplayer and can join full-game sessions
        in Sector 1."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.13
      type: 13
      value: "\u2022 En multijoueur, les dialogues mettent d\xE9sormais la rencontre
        en pause pour tous pendant le combat."
      baseValue: "\u2022 Dialogs in multiplayer now pause the encounter for everyone
        during combat."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.14
      type: 13
      value: "\u2022 Les dialogues multijoueur d\xE9filent automatiquement selon
        un temps de lecture, pour que personne ne reste bloqu\xE9."
      baseValue: "\u2022 Multiplayer dialogs auto-advance on a reading timer so no
        one stays frozen."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.15
      type: 13
      value: "\u2022 La liste des joueurs indique d\xE9sormais qui est en train de
        lire un dialogue."
      baseValue: "\u2022 Player list now shows which players are reading a dialog."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.16
      type: 13
      value: "\u2022 Les nouvelles infobulles de la liste des parties affichent le
        nom, le niveau et le mode de chaque joueur."
      baseValue: "\u2022 New multiplayer game list tooltips show each player's name,
        level, and mode."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.17
      type: 13
      value: "\u2022 Les h\xF4tes peuvent d\xE9sormais expulser ou bannir des joueurs
        avec les commandes de chat /kick et /ban."
      baseValue: "\u2022 Hosts can now kick or ban players with the /kick and /ban
        chat commands."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.18
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.19
      type: 13
      value: "<color=#ffffff>Changements d'\xE9quilibrage</color>"
      baseValue: <color=#ffffff>Balance Changes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.20
      type: 13
      value: "\u2022 Le co\xFBt des am\xE9liorations de raret\xE9 dans l'Assembleur
        a \xE9t\xE9 r\xE9duit de moiti\xE9."
      baseValue: "\u2022 Rarity upgrade costs in the Assembler have been halved."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.21
      type: 13
      value: "\u2022 Votre vaisseau ne peut plus \xEAtre d\xE9truit \xE0 la flotte,
        les r\xE9apparitions sont donc toujours s\xFBres."
      baseValue: "\u2022 Your ship can no longer be destroyed at the fleet, so respawns
        are always safe."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.22
      type: 13
      value: "\u2022 La Torche cryog\xE9nique et le Conduit cin\xE9tique sont d\xE9sormais
        en vente au vaisseau-m\xE8re."
      baseValue: "\u2022 Cryo Torch and Kinetic Conduit are now available for sale
        in the mothership."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.23
      type: 13
      value: "\u2022 Vitesse de l'orbe de foudre de Mj\xF6lnir augment\xE9e de 40\_%."
      baseValue: "\u2022 Increased speed of Mj\xF6lnir's Lightning Orb by 40%."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.24
      type: 13
      value: "\u2022 R\xE9g\xE9n\xE9ration coque du Broodnest Species-XI r\xE9duite
        de 25\_%."
      baseValue: "\u2022 Reduced Hull Regen of Species-XI Broodnest by 25%."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.25
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.26
      type: 13
      value: "<color=#ffffff>Confort de jeu / Accessibilit\xE9</color>"
      baseValue: <color=#ffffff>Quality of Life / Accessibility</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.27
      type: 13
      value: "\u2022 Les sauvegardes avec des mods manquants apparaissent normalement
        dans la liste, en indiquant lesquels manquent."
      baseValue: "\u2022 Saves with missing mods now list normally, showing which
        mods are missing."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.28
      type: 13
      value: "\u2022 Les descriptions d'objets ont \xE9t\xE9 corrig\xE9es pour la
        grammaire et la clart\xE9."
      baseValue: "\u2022 Item descriptions have been corrected for grammar and clarity."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.29
      type: 13
      value: "\u2022 L'\xE9cran multijoueur de la d\xE9mo explique d\xE9sormais comment
        h\xE9berger et rejoindre des parties du Secteur 1."
      baseValue: "\u2022 Demo multiplayer screen now explains hosting and joining
        Sector 1 games."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.30
      type: 13
      value: "\u2022 Le Canon gravitationnel affiche d\xE9sormais un lien vers tout
        ce qu'il attire, qui s'estompe avec la distance."
      baseValue: "\u2022 Gravity Cannon now shows a tether to everything it pulls,
        fading with range."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.31
      type: 13
      value: 
      baseValue: 
      context: 
