      keptEnglish: 1
    - key: core.updateHistory.v0.7.96.1
      type: 13
      value: "\u2022 Le nouveau r\xE9glage graphique Qualit\xE9 de la n\xE9buleuse
        offre un brouillard plus rapide en Moyenne et Basse pour les PC anciens."
      baseValue: "\u2022 New Nebula Quality setting offers faster Medium and Low
        fog for older PCs."
      context: 
