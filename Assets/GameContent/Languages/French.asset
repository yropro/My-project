    - key: SettingsDataControl.cameraDistance.description
      type: 7
      value: Distance de zoom
      baseValue: Zoom Distance
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.cameraDistance.tooltip
      type: 8
      value: "Distance entre la cam\xE9ra et le joueur. Plus le nombre est \xE9lev\xE9,
        plus tout para\xEEtra petit."
      baseValue: Distance of camera from player, the larger the number the smaller
        everything will be.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.uiScale.description
      type: 7
      value: "\xC9chelle IU"
      baseValue: UI Scale
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.uiScale.tooltip
      type: 8
      value: "\xC9chelle de l'interface utilisateur du jeu."
      baseValue: Scale of the user interface around the game.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.hudScale.description
      type: 7
      value: "\xC9chelle ATH"
      baseValue: HUD Scale
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.hudScale.tooltip
      type: 8
      value: "\xC9chelle de l'affichage t\xEAte haute en jeu."
      baseValue: Scale of the heads-up display in game.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.minibarScale.description
      type: 7
      value: "\xC9chelle mini-barre"
      baseValue: Minibar Scale
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.minibarScale.tooltip
      type: 8
      value: "\xC9chelle des minibarres (bouclier / coque / etc.) affich\xE9es sous
        les vaisseaux."
      baseValue: Scale of the minibars (shield / hull / etc) displayed below ships.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.floatingDamageScale.description
      type: 7
      value: "\xC9chelle des d\xE9g\xE2ts chiffr\xE9s"
      baseValue: Damage Number Scale
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.floatingDamageScale.tooltip
      type: 8
      value: "D\xE9finit l'\xE9chelle des nombres de d\xE9g\xE2ts flottants au-dessus
        des vaisseaux ennemis. Un r\xE9glage \xE0 0\_% les d\xE9sactive compl\xE8tement."
      baseValue: Set the scale of floating damage numbers above enemy ships. Setting
        to 0% will disable them entirely.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.cameraShake.description
      type: 7
      value: "Tremblement de cam\xE9ra"
      baseValue: Camera Shake
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.cameraShake.tooltip
      type: 8
      value: "Secoue la cam\xE9ra lorsque vous subissez des d\xE9g\xE2ts ou tirez
        avec des armes lourdes."
      baseValue: Shake the camera when taking damage or firing heavy weapons.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.showWarningGlow.description
      type: 7
      value: Afficher halo d'alerte
      baseValue: Show Warning Glow
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.showWarningGlow.tooltip
      type: 8
      value: "Affiche une lueur sur le bord de l'\xE9cran lorsque votre bouclier
        tombe ou que votre coque est faible."
      baseValue: Shows a glow around the edge of the screen when your shield goes
        down or you are on low health.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.smallShipBar.description
      type: 7
      value: Petite barre de vaisseau
      baseValue: Small Ship Bar
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.smallShipBar.tooltip
      type: 8
      value: "R\xE9duit la barre de vaisseau en bas de l'ATH pour une meilleure visibilit\xE9
        verticale."
      baseValue: Shrink down the ship bar at the bottom of the HUD for more vertical
        visibility.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.playerBars.description
      type: 7
      value: Afficher mini-barres personnages
      baseValue: Show Player Minibars
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.playerBars.tooltip
      type: 8
      value: Affiche des minibarres sous le vaisseau du joueur pour suivre plus facilement
        votre bouclier et votre coque.
      baseValue: Shows minibars below the player ship so you can more easily track
        your shield / hull.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.radialOpacity.description
      type: 7
      value: "Opacit\xE9 de l'affichage radial"
      baseValue: Radial Display Opacity
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.radialOpacity.tooltip
      type: 8
      value: "Le bouclier, la coque et la chaleur sont affich\xE9s en cercle autour
        de votre vaisseau. Ajuster leur opacit\xE9 les rendra plus ou moins visibles\_;
        une valeur de 0\\_% les d\xE9sactivera compl\xE8tement."
      baseValue: Shield, hull and heat are displayed around your ship in a circle.
        Adjusting their opacity will make them more or less visible, setting to 0%
        will disable it entirely.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.description
      type: 7
      value: Ignorer les consommables
      baseValue: Ignore Consumables
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.tooltip
      type: 8
      value: "D\xE9finit quand vous tracterez et ramasserez des consommables.\nJamais
        = Ramasser tous les consommables\nIntelligent = Remplir les piles existantes
        et conserver au moins une pile de consommables assign\xE9s\nToujours = Ne
        ramasser aucun consommable"
      baseValue: 'Set when you will tractor and pick up consumables.

        Never
        = Collect all consumables

        Smart = Fill existing stacks and keep
        at least one stack of assigned consumables

        Always = Do not collect
        any consumables'
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.value.0
      type: 7
      value: Jamais
      baseValue: Never
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.value.1
      type: 7
      value: Intelligent
      baseValue: Smart
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.value.2
      type: 7
      value: Toujours
      baseValue: Always
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.ignoreItemsBelow.description
      type: 7
      value: Ignorer les objets ci-dessous
      baseValue: Ignore Items Below
      context: 
      aiTranslated: 0
      keptEnglish: 0
