      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.12
      type: 13
      value: "\u2022 Le Halo de r\xE9paration r\xE9pare d\xE9sormais aussi vos propres
        drones et tourelles."
      baseValue: "\u2022 Repair Halo now also repairs your own drones and turrets."
