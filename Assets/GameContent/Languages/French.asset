      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.4
      type: 13
      value: "\u2022 Le double-clic sur votre rencontre actuelle dans le panneau
        de navigation ne provoque plus d'hypersaut."
      baseValue: "\u2022 Double-clicking your current encounter in Navigation no
        longer hyperjumps you."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.5
      type: 13
      value: "\u2022 Correction d'une erreur dans l'Assembleur lors du d\xE9placement
        d'objets vers le stockage."
      baseValue: "\u2022 Fixed error in Assembler when trying to move items to storage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.6
      type: 13
      value: "\u2022 Correction des cr\xE9dits qui se divisaient en plusieurs piles
        de cargaison."
      baseValue: "\u2022 Fixed credits splitting into multiple cargo stacks."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.title
      type: 13
      value: Recalibrage
      baseValue: Recalibration
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.0
      type: 13
      value: "<color=#ffffff>Nouveaut\xE9s / Contenu</color>"
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.1
      type: 13
      value: "\u2022 Le nouveau Hangar de l'Assembleur stocke jusqu'\xE0 10 concepts
        de vaisseau interchangeables."
      baseValue: "\u2022 New Assembler Hangar Bay stores up to 10 ship designs you
        can switch between."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.2
      type: 13
      value: "\u2022 R\xE9initialiser les am\xE9liorations ne co\xFBte plus de cr\xE9dits,
        exp\xE9rimentez librement."
      baseValue: "\u2022 Resetting upgrades no longer costs credits, so feel free
        to experiment."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.3
      type: 13
      value: "\u2022 Vous pouvez d\xE9sormais d\xE9poser des cr\xE9dits dans les
        Coffres-forts local et partag\xE9 \xE0 l'Assembleur."
      baseValue: "\u2022 Credits can now be deposited into Local and Shared Vaults
        at the Assembler."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.4
      type: 13
      value: "\u2022 Les secteurs contiennent d\xE9sormais des caches fixes qui l\xE2chent
        des objets rares pr\xE9d\xE9finis."
      baseValue: "\u2022 Sectors now include fixed caches that drop pre-defined rare
        items."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.5
      type: 13
      value: "\u2022 Nouvelle arme secondaire\_: le Canon gravitationnel capture
        d\xE9bris, missiles et drones."
      baseValue: "\u2022 New secondary weapon: the Gravity Cannon captures debris,
        missiles and drones."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.6
      type: 13
      value: "\u2022 Les lasers de d\xE9fense ponctuelle \xE9pargnent les rochers
        et drones que votre Canon gravitationnel veut comme munitions."
      baseValue: "\u2022 Point Defense Lasers spare rocks and drones your Gravity
        Cannon wants as ammo."
