      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.21
      type: 13
      value: "\u2022 Les stats de classe du concepteur de vaisseaux affichent les
        nouveaux multiplicateurs de menace."
      baseValue: "\u2022 Class stats in the ship designer now show the new threat
        multipliers."
