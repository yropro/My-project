    - key: core.updateHistory.v0.7.91.45
      type: 13
      value: "\u2022 Nouveaux utilitaires publics AIController.IsFormationSlaved
        et GravityWell.TryMerge."
      baseValue: "\u2022 New AIController.IsFormationSlaved and GravityWell.TryMerge
        public helpers."
