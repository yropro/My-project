      keptEnglish: 0
    - key: SettingsDataControl.leechParticles.description
      type: 7
      value: Particules Sangsue
      baseValue: Leech Particles
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.leechParticles.tooltip
      type: 8
      value: "Contr\xF4le la fr\xE9quence de g\xE9n\xE9ration des particules Sangsue.
        Des valeurs plus faibles g\xE9n\xE8rent moins de particules mais regroupent
        les r\xE9parations en quantit\xE9s plus importantes."
      baseValue: Controls the rate of leech particles spawned. Lower values spawn
        fewer particles but merge repair amounts into larger amounts.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.leechParticles.value.0
      type: 7
      value: Maximum
      baseValue: Maximum
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: SettingsDataControl.leechParticles.value.1
      type: 7
      value: "\xC9lev\xE9e"
      baseValue: High
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.leechParticles.value.2
      type: 7
      value: Moyenne
      baseValue: Medium
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.leechParticles.value.3
      type: 7
      value: Basse
      baseValue: Low
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.leechParticles.value.4
      type: 7
      value: "D\xE9sactiv\xE9"
      baseValue: Disabled
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.antiAliasing.description
      type: 7
      value: "Anticr\xE9nelage"
      baseValue: Anti-Aliasing
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.antiAliasing.tooltip
      type: 8
      value: "Am\xE9liore l'apparence des bords pour qu'ils ne soient pas \xAB\_cr\xE9nel\xE9s\_\xBB,
        mais liss\xE9s \xE0 l'\xE9cran. Une valeur plus \xE9lev\xE9e am\xE9liore
        le rendu mais peut r\xE9duire les performances."
      baseValue: Improves the appearance of edges, so they are not 'jagged', but
        smoothed out on the screen. A higher number will improve visuals but may
        decrease performance.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.renderScale.description
      type: 7
      value: "\xC9chelle de rendu"
      baseValue: Render Scale
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.renderScale.tooltip
      type: 8
      value: "Effectuer le rendu \xE0 une r\xE9solution inf\xE9rieure ou sup\xE9rieure
        \xE0 celle de l'\xE9cran pour am\xE9liorer les performances ou la qualit\xE9."
      baseValue: Render at a lower or higher resolution than the screen for performance
        or improved quality.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.targetFramerate.description
      type: 7
      value: "Taux de rafra\xEEchissement cible"
      baseValue: Target Framerate
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.targetFramerate.tooltip
      type: 8
      value: "D\xE9finit la fr\xE9quence d'images cible et la synchronisation verticale\_;
        ce param\xE8tre peut \xEAtre ignor\xE9 sur certaines plateformes."
      baseValue: Set the target frame-rate and vertical sync setting, this may be
        ignored on some platforms.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.targetFramerate.value.0
      type: 7
      value: "Illimit\xE9"
      baseValue: Unlimited
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.targetFramerate.value.1
      type: 7
      value: Sync. verticale
      baseValue: Vertical Sync
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.bloom.description
      type: 7
      value: "Intensit\xE9 du flou lumineux"
      baseValue: Bloom Intensity
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.bloom.tooltip
      type: 8
      value: "Modifie l'intensit\xE9 de l'effet de bloom sur les lumi\xE8res."
      baseValue: Changes the intensity of the bloom effect on lights.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.dynamicGlow.description
      type: 7
      value: Lueur dynamique
      baseValue: Dynamic Glow
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.dynamicGlow.tooltip
      type: 8
      value: "Intensit\xE9 de la lumi\xE8re projet\xE9e sur les vaisseaux et les
        ast\xE9ro\xEFdes par les flammes, rayons et explosions \xE0 proximit\xE9.
        R\xE9glez sur 0 pour d\xE9sactiver compl\xE8tement l'effet."
      baseValue: Intensity of the light cast onto ships and asteroids by nearby flames,
        beams and explosions. Set to 0 to disable the effect entirely.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.nebulaQuality.description
      type: 7
      value: "Qualit\xE9 de la n\xE9buleuse"
      baseValue: Nebula Quality
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.nebulaQuality.tooltip
      type: 8
      value: "Qualit\xE9 de l'effet de brouillard de n\xE9buleuse. Les r\xE9glages
        inf\xE9rieurs utilisent un brouillard plus simple, bien plus rapide sur les
        anciennes cartes graphiques."
      baseValue: Quality of the nebula fog effect. Lower settings use a simpler fog
        that runs much faster on older graphics cards.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.nebulaQuality.value.0
      type: 7
      value: "\xC9lev\xE9e"
      baseValue: High
      context: 
