      keptEnglish: 0
    - key: IDll0rCJ.name
      type: 5
      value: Xenosis
      baseValue: Xenosis
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: Dlbb7rr7.name
      type: 5
      value: Cindros
      baseValue: Cindros
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: Dlbb7rr7.arrivalDialog.0
      type: 2
      value: "C'est ici que votre chemin s'ach\xE8ve. La galaxie appartient \xE0
        ceux qui ont la force de la r\xE9\xE9crire."
      baseValue: This is where your path ends. The galaxy belongs to those with the
        strength to rewrite it.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: lALYBu7d.name
      type: 5
      value: Crypsis
      baseValue: Crypsis
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: lALYBu7d.arrivalDialog.0
      type: 2
      value: "Votre d\xE9fi est illogique. Rendez-vous maintenant pour une pr\xE9servation
        optimale."
      baseValue: Your defiance is illogical. Surrender now for optimal preservation.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: YwqQzBs8.name
      type: 5
      value: Eden
      baseValue: Eden
      context: 
