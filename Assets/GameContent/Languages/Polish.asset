      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.6
      type: 13
      value: "\u2022 Ustawienia trudno\u015Bci wymieniaj\u0105 obra\u017Cenia na
        twardsze statki, wi\u0119cej wrog\xF3w i wi\u0119cej zachowywanych zasob\xF3w."
      baseValue: "\u2022 Difficulty presets trade damage for tougher ships, more
        enemies, more salvage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.7
      type: 13
      value: "\u2022 W\u0119gorze poruszaj\u0105 si\u0119 teraz o 20% wolniej."
      baseValue: "\u2022 Eels now move 20% slower."
      context: 
      aiTranslated: 1
      keptEnglish: 0
