      keptEnglish: 0
    - key: SettingsDataControl.uiScale.tooltip
      type: 8
      value: "Skala interfejsu u\u017Cytkownika."
      baseValue: Scale of the user interface around the game.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.hudScale.description
      type: 7
      value: Skala HUD-u
      baseValue: HUD Scale
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.hudScale.tooltip
      type: 8
      value: "Skala wy\u015Bwietlacza heads-up w grze."
      baseValue: Scale of the heads-up display in game.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.minibarScale.description
      type: 7
      value: Rozmiar minipaska
      baseValue: Minibar Scale
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.minibarScale.tooltip
      type: 8
      value: "Skala mini-pask\xF3w (os\u0142ona / kad\u0142ub / itp.) wy\u015Bwietlanych
        pod statkiem."
      baseValue: Scale of the minibars (shield / hull / etc) displayed below ships.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.floatingDamageScale.description
      type: 7
      value: "Skala warto\u015Bci szk\xF3d"
      baseValue: Damage Number Scale
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.floatingDamageScale.tooltip
      type: 8
      value: "Ustaw skal\u0119 liczb obra\u017Ce\u0144 wy\u015Bwietlanych nad statkami
        wroga. Ustawienie warto\u015Bci 0% spowoduje ca\u0142kowite wy\u0142\u0105czenie
        tej funkcji."
      baseValue: Set the scale of floating damage numbers above enemy ships. Setting
        to 0% will disable them entirely.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.cameraShake.description
      type: 7
      value: "Dr\u017Cenie kamery"
      baseValue: Camera Shake
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.cameraShake.tooltip
      type: 8
      value: "Potrz\u0105sa kamer\u0105, gdy otrzymujesz obra\u017Cenia lub strzelasz
        z ci\u0119\u017Ckiej broni."
      baseValue: Shake the camera when taking damage or firing heavy weapons.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.showWarningGlow.description
      type: 7
      value: "Poka\u017C blask ostrzegawczy"
      baseValue: Show Warning Glow
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.showWarningGlow.tooltip
      type: 8
      value: "Pokazuje po\u015Bwiat\u0119 wok\xF3\u0142 kraw\u0119dzi ekranu, gdy
        twoja os\u0142ona spada lub masz niski poziom zdrowia."
      baseValue: Shows a glow around the edge of the screen when your shield goes
        down or you are on low health.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.smallShipBar.description
      type: 7
      value: "Ma\u0142y pasek statku"
      baseValue: Small Ship Bar
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: SettingsDataControl.smallShipBar.tooltip
      type: 8
      value: "Zmniejsza pasek statku na dole HUD, aby zyska\u0107 wi\u0119ksz\u0105
        widoczno\u015B\u0107 w pionie."
      baseValue: Shrink down the ship bar at the bottom of the HUD for more vertical
        visibility.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.playerBars.description
      type: 7
