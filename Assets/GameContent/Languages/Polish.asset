      keptEnglish: 0
    - key: PtAWL7BT
      type: 9
      value: "Dzi\u0119kujemy za gr\u0119"
      baseValue: Thanks For Playing
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: d0PwM3QM
      type: 8
      value: "Dzi\u0119kujemy za po\u015Bwi\u0119cenie czasu na obejrzenie wersji
        demonstracyjnej!\n\nGra Star Vortex jest ju\u017C dost\u0119pna w ramach
        wczesnego dost\u0119pu! Kup swoj\u0105 kopi\u0119 na Steamie i kontynuuj
        swoj\u0105 podr\xF3\u017C. Wszystkie zapisy zostan\u0105 przeniesione do
        pe\u0142nej wersji!"
      baseValue: 'Thanks for taking the time to checkout the demo!


        Star
        Vortex is out now in Early Access! Grab your copy on Steam and continue your
        journey. All saves carry over to the full version!'
      context: 
      aiTranslated: 0
      keptEnglish: 0
