    - key: vVHMYbzU.name
      type: 5
      value: "Bazyliszek (G\u0142owa)"
      baseValue: Basilisk (Head)
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.0
      type: 2
      value: "Wydajny. Brutalny. Wiedzia\u0142em, \u017Ce nie zawiedziesz."
      baseValue: Efficient. Brutal. I knew you wouldn't disappoint.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.1
      type: 2
      value: "Ten komponent nigdy nie nale\u017Ca\u0142 do nich. Nale\u017Ca\u0142
        do tych, kt\xF3rzy przyszli wcze\u015Bniej."
      baseValue: This component was never theirs to begin with. It belonged to the
        ones who came before.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.2
      type: 2
      value: ','
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.3
      type: 2
      value: "Nie zwlekaj. Jest wi\u0119cej do zniszczenia... i wi\u0119cej do zbudowania."
      baseValue: Don't linger. There's more to break... and more to build.
      context: 
      aiTranslated: 0
      keptEnglish: 0
