      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.6
      type: 13
      value: "\u2022 Naprawiono dzielenie kredyt\xF3w na wiele stos\xF3w w \u0142adowni."
      baseValue: "\u2022 Fixed credits splitting into multiple cargo stacks."
