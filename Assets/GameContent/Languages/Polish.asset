  - categoryName: Component.Death
    entries:
    - key: Death.regularDesc
      type: 8
      value: "Utracono {0} kredyt(\xF3w). Czy chcesz si\u0119 odrodzi\u0107?"
      baseValue: You have died and dropped {0} credit(s). Would you like to respawn?
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: Death.hardcoreDesc
      type: 8
      value: "Respawn jest wy\u0142\u0105czony dla graczy hardcore"
      baseValue: Respawn is disabled for hardcore players.
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: Death.additionalSources
      type: 8
      value: "Z {0} dodatkowych \u017Ar\xF3de\u0142..."
      baseValue: From {0} additional sources...
      context: 
      aiTranslated: 1
