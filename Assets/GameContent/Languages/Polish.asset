    - key: core.updateHistory.v0.7.91.1
      type: 13
      value: "\u2022 Nowy suwak trudno\u015Bci Wrogowie skaluje liczebno\u015B\u0107
        eskadr wroga od 50% do 200%."
      baseValue: "\u2022 New Enemies difficulty slider scales enemy squadron numbers
        from 50% to 200%."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.2
      type: 13
      value: "\u2022 Nowe sloty Silnika ozdobnego dodaj\u0105 kosmetyczne silniki
        kierunkowe do projekt\xF3w statk\xF3w."
      baseValue: "\u2022 New Vanity Thruster slots add cosmetic directional thrusters
        to ship designs."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.3
      type: 13
      value: "\u2022 Nowa bro\u0144 poboczna Promie\u0144 naprawczy naprawia przyjazne
        statki."
      baseValue: "\u2022 New Repair Ray secondary weapon repairs friendly ships."
