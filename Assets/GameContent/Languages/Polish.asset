      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.96.5
      type: 13
      value: "\u2022 Naprawiono b\u0142\u0105d w Statku monta\u017Cowym przy pr\xF3bie
        przeniesienia przedmiot\xF3w do magazynu."
      baseValue: "\u2022 Fixed error in Assembler when trying to move items to storage."
