      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.10
      type: 13
      value: "\u2022 Przedmioty na maksymalnym poziomie mog\u0105 za darmo Przeliczy\u0107
        statystyki, by wprowadzi\u0107 zmiany balansu."
      baseValue: "\u2022 Level-capped items can Recalculate Stats for free to apply
        balance updates."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.11
      type: 13
      value: "\u2022 L\xF3d Fabrykatora lodu wygl\u0105da teraz jak barwione szk\u0142o
        zamiast bladego, p\u0142askiego lodu."
      baseValue: "\u2022 Ice Fabricator ice now looks like tinted glass instead of
        pale, flat ice."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.12
      type: 13
      value: "\u2022 P\u0142omienie, wi\u0105zki, eksplozje i silniki rzucaj\u0105
        teraz \u015Bwiat\u0142o na pobliskie obiekty."
      baseValue: "\u2022 Flames, beams, explosions and engines now cast light onto
        nearby objects."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.13
      type: 13
      value: "\u2022 Nowy suwak grafiki Dynamiczny blask reguluje rozlewanie \u015Bwiat\u0142a;
        0 wy\u0142\u0105cza efekt."
      baseValue: "\u2022 New Dynamic Glow graphics slider adjusts light spill; set
        to 0 to disable."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.14
      type: 13
      value: "\u2022 Silniki pokazuj\u0105 sylwetk\u0119 podczas umieszczania slot\xF3w,
        bo chowaj\u0105 si\u0119 pod kad\u0142ubem."
      baseValue: "\u2022 Thrusters show a silhouette while placing slots as they
        hide under the hull."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.15
      type: 13
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
