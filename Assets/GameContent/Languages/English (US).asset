      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.8
      type: 13
      value: "\u2022 Steam players are no longer dropped when a slow connection briefly
        backs up."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.9
      type: 13
      value: "\u2022 Music no longer stutters in big fights, as the audio voice limit
        was too low."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.10
      type: 13
      value: "\u2022 Distant sounds now fade to silence beyond 1.4 km instead of
        lingering faintly."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.11
      type: 13
      value: "\u2022 Volume sliders now apply on launch instead of after the first
        settings save."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.12
      type: 13
      value: "\u2022 AI ship turrets now swing back forward once their target is
        gone."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.13
      type: 13
      value: "\u2022 Radar enemy count no longer freezes when a converted ship joins
        a squadron."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.14
      type: 13
      value: "\u2022 Arriving in a friend's encounter no longer leaves your ship
        white and stuck."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.15
      type: 13
      value: "\u2022 Gravity Cannon shots now explode at the end of their flight,
        not just vanish."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.01.16
      type: 13
      value: "\u2022 Jumping between encounters with a Vortex Array no longer causes
        an error."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.title
      type: 13
      value: Multiplayer
      baseValue: 
