      keptEnglish: 0
    - key: roadmap.3.description
      type: 9
      value: Remove the 4 slot limit on slot types allowing ship designs to have
        any number of primary, secondary, special or auto special slots.
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: roadmap.4.subheader
      type: 9
      value: Upgrade Overhaul
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: roadmap.4.description
      type: 9
      value: Rework the upgrade tree to allow for different play styles and more
        freedom. Adding support for tankier builds and faster ships.
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: roadmap.5.subheader
      type: 9
      value: Secondary Classes
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: roadmap.5.description
      type: 9
      value: Add a wide range of secondary classes, each built around distinct playstyles
        with strong damage type specialisations.
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: roadmap.6.subheader
      type: 9
      value: Close Combat
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
