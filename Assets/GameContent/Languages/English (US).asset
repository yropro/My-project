      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.4
      type: 13
      value: "\u2022 Fixed an error when a drone or turret lost a hull part while
        time was paused."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.5
      type: 13
      value: "\u2022 Fixed an error joining a session while the host completed an
