    - key: pSEK85cf.name
      type: 5
      value: Baldur (Enraged)
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: LTCYMBG4.name
      type: 5
      value: Basilisk (Body - Laser)
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: ZMpFKcx6.name
      type: 5
      value: Basilisk (Body - Tornado)
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.name
      type: 5
      value: Basilisk (Head)
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.0
      type: 2
      value: Efficient. Brutal. I knew you wouldn't disappoint.
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.1
      type: 2
      value: This component was never theirs to begin with. It belonged to the ones
        who came before.
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.2
      type: 2
      value: 
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.3
      type: 2
      value: Don't linger. There's more to break... and more to build.
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: We6Y09DS.name
      type: 5
      value: Basilisk (Tail)
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: zIXoafRS.name
      type: 5
      value: Behemoth
