      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.1
      type: 13
      value: "\u2022 Undocking now rebuilds hull collision so shieldless ships can
        collect items."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.2
      type: 13
      value: "\u2022 Fixed an error taking over a co-op encounter holding a mind-controlled
        ship."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.04.3
      type: 13
      value: "\u2022 Fixed an error after moving a mirrored beam weapon to an unmirrored
