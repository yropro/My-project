    - key: roadmap.1.description
      type: 9
      value: Improve the visual effects of particles and hit effects so weapons are
        more satisfying to use.
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: roadmap.2
      type: 9
