      keptEnglish: 0
    - key: roadmap.11.description
      type: 9
      value: Finish the defence of Earth (Level 55 - 60), activate the weapon, and
        face your true enemy. Discover unlikely allies in the conclusion of the game's
        storyline.
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
