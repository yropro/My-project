      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.8
      type: 13
      value: "\u2022 Fixed dying with a panel open in multiplayer leaving the ship
        immortal."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.9
      type: 13
      value: "\u2022 Saves affected by the immortal ship bug now recover on the next
        respawn."
      baseValue: 
      context: 
      aiTranslated: 0
      keptEnglish: 0
    - key: core.updateHistory.v0.8.05.10
      type: 13
      value: "\u2022 Unusable extra Gateway Ciphers from multiplayer are now removed
