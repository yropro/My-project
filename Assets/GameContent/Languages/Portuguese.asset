      type: 13
      value: "\u2022 Adicionados HangarDesign, Player.hangarDesigns e Pilot.SetUpgradeUnlocks()."
      baseValue: "\u2022 Added HangarDesign, Player.hangarDesigns and Pilot.SetUpgradeUnlocks()."
