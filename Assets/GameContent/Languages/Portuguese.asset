      keptEnglish: 0
    - key: ZIZW21Vn.arrivalDialog.1
      type: 2
      value: "\xC9 vermelho, ESA. Desde quando vermelho significa \u201Cbom\u201D?"
      baseValue: It's red, ESA. When has red ever meant 'good'?
