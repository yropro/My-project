      type: 13
      value: "\u2022 SceneGlowFeature.RegisterLine adiciona emissores de linha personalizados
        \xE0 captura de brilho."
      baseValue: "\u2022 SceneGlowFeature.RegisterLine adds custom line emitters
        to the glow capture."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.45
      type: 13
      value: "\u2022 Novos auxiliares p\xFAblicos AIController.IsFormationSlaved
        e GravityWell.TryMerge."
      baseValue: "\u2022 New AIController.IsFormationSlaved and GravityWell.TryMerge
        public helpers."
