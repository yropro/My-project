      type: 13
      value: "Recalibra\xE7\xE3o"
      baseValue: Recalibration
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.0
      type: 13
      value: "<color=#ffffff>Novos Recursos / Conte\xFAdo</color>"
      baseValue: <color=#ffffff>New Features / Content</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.1
      type: 13
      value: "\u2022 O novo Hangar do Montador guarda at\xE9 10 designs de nave para
        voc\xEA alternar."
      baseValue: "\u2022 New Assembler Hangar Bay stores up to 10 ship designs you
        can switch between."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.2
      type: 13
      value: "\u2022 Redefinir aprimoramentos n\xE3o custa mais cr\xE9ditos, ent\xE3o
        experimente \xE0 vontade."
      baseValue: "\u2022 Resetting upgrades no longer costs credits, so feel free
        to experiment."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.3
      type: 13
      value: "\u2022 Agora \xE9 poss\xEDvel depositar cr\xE9ditos nos Cofres Local
        e Compartilhado no Montador."
      baseValue: "\u2022 Credits can now be deposited into Local and Shared Vaults
        at the Assembler."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.4
      type: 13
      value: "\u2022 Os setores agora incluem caches fixos que soltam itens raros
        predefinidos."
      baseValue: "\u2022 Sectors now include fixed caches that drop pre-defined rare
        items."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.5
      type: 13
      value: "\u2022 Nova arma secund\xE1ria: o Canh\xE3o Gravitacional captura destro\xE7os,
        m\xEDsseis e drones."
      baseValue: "\u2022 New secondary weapon: the Gravity Cannon captures debris,
        missiles and drones."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.6
      type: 13
      value: "\u2022 Os Lasers de Point Defense poupam rochas e drones que seu Canh\xE3o
        Gravitacional quer como muni\xE7\xE3o."
      baseValue: "\u2022 Point Defense Lasers spare rocks and drones your Gravity
        Cannon wants as ammo."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.7
      type: 13
      value: "\u2022 O novo item Transponder permite que builds de tanque gerem amea\xE7a
        passivamente nos inimigos."
      baseValue: "\u2022 New Transponder item allows tank builds to passively gain
        threat on enemies."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.8
      type: 13
      value: "\u2022 Adicionado um novo avatar de jogador para escolher ao criar
        um piloto."
      baseValue: "\u2022 Added a new player avatar to choose from when creating a
        pilot."
      context: 
      aiTranslated: 1
