      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.31
      type: 13
      value: "\u2022 Os valores m\xE1ximos de modificador no Gloss\xE1rio agora refletem
        os limites maiores de Raro e Lend\xE1rio."
      baseValue: "\u2022 Glossary max modifier values now reflect the higher Rare
        and Legendary caps."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.32
      type: 13
      value: "\u2022 Os mapas estelares do Radar e da Navega\xE7\xE3o n\xE3o divergem
        mais sobre quais estrelas t\xEAm saque."
      baseValue: "\u2022 Radar and Navigation star maps no longer disagree on which
        stars hold loot."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.33
      type: 13
      value: "\u2022 Corrigido um erro ap\xF3s a destrui\xE7\xE3o de um l\xEDder
        de esquadr\xE3o sob controle mental."
      baseValue: "\u2022 Fixed an error after a mind-controlled squadron leader was
        destroyed."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.34
      type: 13
      value: "\u2022 Corrigido o ziguezague dos m\xEDsseis Tornado no lan\xE7amento
        causado pelo amortecimento lento da curva."
      baseValue: "\u2022 Fixed Tornado missiles zigzagging at launch due to slow
        steering damping."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.35
      type: 13
      value: "\u2022 Os Lasers de Point Defense n\xE3o miram mais em m\xEDsseis inofensivos
        de aliados que j\xE1 partiram."
      baseValue: "\u2022 Point Defense Lasers no longer target harmless missiles
        from departed allies."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.36
      type: 13
      value: "\u2022 Desfazer ap\xF3s carregar um modelo ou uma importa\xE7\xE3o
        agora restaura sua nave anterior."
      baseValue: "\u2022 Undo after loading a template or import now restores your
        previous ship."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.37
      type: 13
      value: "\u2022 A lista de pe\xE7as do Construtor de naves n\xE3o abre mais
        rolada pela metade."
      baseValue: "\u2022 The Ship Builder parts list no longer opens scrolled partway
        along."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.38
      type: 13
      value: "\u2022 A sele\xE7\xE3o por controle n\xE3o escolhe mais itens da lista
        que est\xE3o fora da \xE1rea vis\xEDvel."
      baseValue: "\u2022 Controller selection no longer picks list items scrolled
        out of view."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.39
      type: 13
      value: "\u2022 Po\xE7os gravitacionais e buracos negros n\xE3o arremessam mais
        os segmentos dos inimigos serpente."
      baseValue: "\u2022 Gravity wells and black holes no longer send snake enemy
        segments flying."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.40
      type: 13
      value: "\u2022 Os segmentos dos inimigos serpente n\xE3o se afastam mais quando
        h\xE1 muitas naves no combate."
      baseValue: "\u2022 Snake enemy segments no longer drift apart when many ships
        are in the fight."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.41
      type: 13
      value: "\u2022 Os an\xE9is de slot de propulsor do Construtor de naves agora
        aparecem acima do casco, e n\xE3o sob ele."
      baseValue: "\u2022 Ship Builder thruster slot rings now show above the hull
        instead of under it."
      context: 
      aiTranslated: 1
      keptEnglish: 0
