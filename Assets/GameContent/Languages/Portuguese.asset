  - categoryName: Component.Death
    entries:
    - key: Death.regularDesc
      type: 8
      value: "Voc\xEA morreu e soltou {0} cr\xE9dito(s). Gostaria de reaparecer?"
      baseValue: You have died and dropped {0} credit(s). Would you like to respawn?
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: Death.hardcoreDesc
      type: 8
      value: "Reaparecer est\xE1 desabilitado para jogadores hardcore."
