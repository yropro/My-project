      type: 13
      value: "<color=#ffffff>Mudan\xE7as de Balanceamento</color>"
      baseValue: <color=#ffffff>Balance Changes</color>
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.6
      type: 13
      value: "\u2022 Predefini\xE7\xF5es de dificuldade trocam dano por naves mais
        resistentes, mais inimigos e mais recupera\xE7\xE3o."
      baseValue: "\u2022 Difficulty presets trade damage for tougher ships, more
        enemies, more salvage."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.7
      type: 13
      value: "\u2022 Eels agora se movem 20% mais devagar."
      baseValue: "\u2022 Eels now move 20% slower."
