      aiTranslated: 1
      keptEnglish: 0
    - key: 0lTPPaVb.arrivalDialog.2
      type: 2
      value: "Apenas algo de uma das s\xE9ries de TV que guardei."
      baseValue: Just something from one of the TV series I kept.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: 0lTPPaVb.arrivalDialog.3
      type: 2
      value: Vou lhe mostrar um mundo sem pecado.
      baseValue: I'm going to show you a world without sin.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: 0lTPPaVb.arrivalDialog.4
      type: 2
      value: "Viu? Ele entendeu a refer\xEAncia..."
      baseValue: See? He got the reference...
