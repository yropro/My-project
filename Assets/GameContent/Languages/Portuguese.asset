      keptEnglish: 0
    - key: core.updateHistory.v0.7.92.19
      type: 13
      value: "\u2022 Corrigido um erro quando um feixe de laser atingia um alvo ap\xF3s
        sua nave ser destru\xEDda."
      baseValue: "\u2022 Fixed an error when a laser beam hit a target after its
        ship was destroyed."
