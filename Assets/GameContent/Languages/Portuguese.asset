      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.1
      type: 13
      value: "\u2022 O novo controle deslizante de dificuldade Inimigos ajusta os
        esquadr\xF5es inimigos de 50% a 200%."
      baseValue: "\u2022 New Enemies difficulty slider scales enemy squadron numbers
        from 50% to 200%."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.2
      type: 13
      value: "\u2022 Novos slots de Propulsor Cosm\xE9tico adicionam propulsores
        direcionais decorativos ao design da nave."
      baseValue: "\u2022 New Vanity Thruster slots add cosmetic directional thrusters
        to ship designs."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.3
      type: 13
      value: "\u2022 Nova arma secund\xE1ria Raio de Reparo repara naves aliadas."
      baseValue: "\u2022 New Repair Ray secondary weapon repairs friendly ships."
