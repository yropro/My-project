      keptEnglish: 1
    - key: 15rTZw3b.arrivalDialog.0
      type: 2
      value: "Olha s\xF3! Problema em dobro. Uma dupla se unindo... igual a n\xF3s!"
      baseValue: Oh, look! Double trouble. A pair teaming up... just like us!
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: 15rTZw3b.arrivalDialog.1
      type: 2
      value: "Gostaria de saber qual \xE9 o c\xE9rebro..."
