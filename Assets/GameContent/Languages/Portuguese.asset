      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.92.20
      type: 13
      value: "\u2022 Buracos negros n\xE3o param mais de causar dano quando a nave
        que os disparou morre."
      baseValue: "\u2022 Black holes no longer stop dealing damage when the ship
        that fired them dies."
