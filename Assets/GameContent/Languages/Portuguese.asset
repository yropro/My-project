      aiTranslated: 1
      keptEnglish: 0
    - key: ZIZW21Vn.arrivalDialog.2
      type: 2
      value: "Molho \xE9 vermelho. Fajitas precisam de molho. Caso encerrado."
      baseValue: Salsa is red. Fajitas need salsa. I rest my case.
