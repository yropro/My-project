      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.29
      type: 13
      value: "\u2022 La pantalla de multijugador de la demo ahora explica c\xF3mo
        crear partidas del Sector 1 y unirse a ellas."
      baseValue: "\u2022 Demo multiplayer screen now explains hosting and joining
        Sector 1 games."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.30
      type: 13
      value: "\u2022 El Ca\xF1\xF3n de gravedad ahora muestra un amarre a todo lo
        que atrae, que se aten\xFAa con la distancia."
      baseValue: "\u2022 Gravity Cannon now shows a tether to everything it pulls,
        fading with range."
