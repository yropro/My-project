      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.7
      type: 13
      value: "\u2022 El nuevo objeto Transpondedor permite a las naves tanque generar
        amenaza de forma pasiva en los enemigos."
      baseValue: "\u2022 New Transponder item allows tank builds to passively gain
        threat on enemies."
