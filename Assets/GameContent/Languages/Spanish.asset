      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.49
      type: 13
      value: "\u2022 Las armas de fuego continuo ahora enmudecen al sobrecalentarse,
        ya que no disparan."
      baseValue: "\u2022 Constant-fire weapons now go silent while overheated since
        nothing is firing."
