    - key: core.updateHistory.v0.7.91.1
      type: 13
      value: "\u2022 El nuevo control de dificultad Enemigos escala los escuadrones
        enemigos del 50% al 200%."
      baseValue: "\u2022 New Enemies difficulty slider scales enemy squadron numbers
        from 50% to 200%."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.2
      type: 13
      value: "\u2022 Las nuevas ranuras de Propulsor decorativo a\xF1aden propulsores
        direccionales cosm\xE9ticos a los dise\xF1os de naves."
      baseValue: "\u2022 New Vanity Thruster slots add cosmetic directional thrusters
        to ship designs."
      context: 
