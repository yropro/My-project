  - categoryName: Component.SettingsDataControl
    entries:
    - key: SettingsDataControl.cameraDistance.description
      type: 7
      value: Distancia de zoom
      baseValue: Zoom Distance
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.cameraDistance.tooltip
      type: 8
      value: "Distancia de la c\xE1mara respecto al jugador; cuanto mayor sea el
        n\xFAmero, m\xE1s peque\xF1o se ver\xE1 todo."
      baseValue: Distance of camera from player, the larger the number the smaller
        everything will be.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.uiScale.description
      type: 7
      value: Escala de IU
      baseValue: UI Scale
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.uiScale.tooltip
      type: 8
      value: Escala de la interfaz de usuario alrededor del juego.
      baseValue: Scale of the user interface around the game.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.hudScale.description
      type: 7
      value: Escala HUD
      baseValue: HUD Scale
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.hudScale.tooltip
      type: 8
      value: Escala del HUD en el juego.
      baseValue: Scale of the heads-up display in game.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.minibarScale.description
      type: 7
      value: Escala de minibarras
      baseValue: Minibar Scale
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.minibarScale.tooltip
      type: 8
      value: Escala de las minibarras (escudo / casco / etc.) que se muestran debajo
        de las naves.
      baseValue: Scale of the minibars (shield / hull / etc) displayed below ships.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.floatingDamageScale.description
      type: 7
      value: "Escala de n\xFAmeros de da\xF1o"
      baseValue: Damage Number Scale
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.floatingDamageScale.tooltip
      type: 8
      value: "Establece la escala de los n\xFAmeros de da\xF1o flotantes sobre las
        naves enemigas. Ajustar al 0% los desactivar\xE1 por completo."
      baseValue: Set the scale of floating damage numbers above enemy ships. Setting
        to 0% will disable them entirely.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.cameraShake.description
      type: 7
      value: "Temblor de c\xE1mara"
      baseValue: Camera Shake
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.cameraShake.tooltip
      type: 8
      value: "Agita la c\xE1mara al recibir da\xF1o o disparar armas pesadas."
      baseValue: Shake the camera when taking damage or firing heavy weapons.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.showWarningGlow.description
      type: 7
      value: Resplandor de aviso
      baseValue: Show Warning Glow
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.showWarningGlow.tooltip
      type: 8
      value: Muestra un brillo alrededor del borde de la pantalla cuando tu escudo
        baja o tienes poca salud.
      baseValue: Shows a glow around the edge of the screen when your shield goes
        down or you are on low health.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.smallShipBar.description
      type: 7
      value: "Barra de nave peque\xF1a"
      baseValue: Small Ship Bar
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.smallShipBar.tooltip
      type: 8
      value: "Reduce el tama\xF1o de la barra de la nave en la parte inferior del
        HUD para tener m\xE1s visibilidad vertical."
      baseValue: Shrink down the ship bar at the bottom of the HUD for more vertical
        visibility.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.playerBars.description
      type: 7
      value: Mostrar minibarras del jugador
      baseValue: Show Player Minibars
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.playerBars.tooltip
      type: 8
      value: "Muestra minibarras debajo de la nave del jugador para que puedas rastrear
        m\xE1s f\xE1cilmente tu escudo/casco."
      baseValue: Shows minibars below the player ship so you can more easily track
        your shield / hull.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.radialOpacity.description
      type: 7
      value: "Opacidad de visualizaci\xF3n radial"
      baseValue: Radial Display Opacity
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.radialOpacity.tooltip
      type: 8
      value: "El escudo, el casco y el calor se muestran alrededor de tu nave en
        un c\xEDrculo. Ajustar su opacidad los har\xE1 m\xE1s o menos visibles; si
        se establece al 0%, se desactivar\xE1 por completo."
      baseValue: Shield, hull and heat are displayed around your ship in a circle.
        Adjusting their opacity will make them more or less visible, setting to 0%
        will disable it entirely.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.description
      type: 7
      value: Ignorar consumibles
      baseValue: Ignore Consumables
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.tooltip
      type: 8
      value: "Establece cu\xE1ndo usar\xE1s el tractor y recoger\xE1s los consumibles.\nNunca
        = Recoger todos los consumibles\nInteligente = Llenar las pilas existentes
        y mantener al menos una pila de consumibles asignados\nSiempre = No recoger
        ning\xFAn consumible"
      baseValue: 'Set when you will tractor and pick up consumables.

        Never
        = Collect all consumables

        Smart = Fill existing stacks and keep
        at least one stack of assigned consumables

        Always = Do not collect
        any consumables'
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.value.0
      type: 7
      value: Nunca
      baseValue: Never
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.value.1
      type: 7
      value: Elegante
      baseValue: Smart
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreConsumables.value.2
      type: 7
      value: Siempre
      baseValue: Always
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreItemsBelow.description
      type: 7
      value: Ignorar los objetos siguientes
      baseValue: Ignore Items Below
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreItemsBelow.tooltip
      type: 8
      value: "Establece la rareza m\xEDnima del equipo que podr\xE1s tractorizar
        y recoger."
      baseValue: Set the minimum rarity of equipment you will be able to tractor
        and pick up.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreItemsBelow.value.0
      type: 7
      value: "Com\xFAn"
      baseValue: Common
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreItemsBelow.value.1
      type: 7
      value: "Poco com\xFAn"
      baseValue: Different
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreItemsBelow.value.2
      type: 7
      value: Raro
      baseValue: Rare
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.ignoreItemsBelow.value.3
      type: 7
      value: Legendario
      baseValue: Legendary
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: SettingsDataControl.confirmItemDiscard.description
      type: 7
      value: Confirmar descarte de objeto
      baseValue: Item Discard Confirm
