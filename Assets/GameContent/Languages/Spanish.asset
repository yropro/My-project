    - key: core.updateHistory.v0.7.91.10
      type: 13
      value: "\u2022 Los objetos con nivel m\xE1ximo pueden Recalcular estad\xEDsticas
        gratis para aplicar los cambios de equilibrio."
      baseValue: "\u2022 Level-capped items can Recalculate Stats for free to apply
        balance updates."
