    - key: core.updateHistory.v0.7.91.44
      type: 13
      value: "\u2022 SceneGlowFeature.RegisterLine a\xF1ade emisores de l\xEDnea
        personalizados a la captura del resplandor."
      baseValue: "\u2022 SceneGlowFeature.RegisterLine adds custom line emitters
        to the glow capture."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.45
      type: 13
      value: "\u2022 Nuevos ayudantes p\xFAblicos AIController.IsFormationSlaved
        y GravityWell.TryMerge."
      baseValue: "\u2022 New AIController.IsFormationSlaved and GravityWell.TryMerge
        public helpers."
