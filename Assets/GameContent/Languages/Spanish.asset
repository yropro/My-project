      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.11
      type: 13
      value: "\u2022 El hielo del Fabricador de hielo ahora parece vidrio tintado
        en lugar de hielo p\xE1lido y plano."
      baseValue: "\u2022 Ice Fabricator ice now looks like tinted glass instead of
        pale, flat ice."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.12
      type: 13
      value: "\u2022 Las llamas, los rayos, las explosiones y los motores ahora proyectan
        luz sobre los objetos cercanos."
      baseValue: "\u2022 Flames, beams, explosions and engines now cast light onto
        nearby objects."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.13
      type: 13
      value: "\u2022 El nuevo control gr\xE1fico Resplandor din\xE1mico ajusta la
        dispersi\xF3n de luz; ponlo en 0 para desactivarlo."
      baseValue: "\u2022 New Dynamic Glow graphics slider adjusts light spill; set
        to 0 to disable."
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.91.14
      type: 13
      value: "\u2022 Los propulsores muestran una silueta al colocar ranuras, ya
        que quedan ocultos bajo el casco."
      baseValue: "\u2022 Thrusters show a silhouette while placing slots as they
        hide under the hull."
