      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.8.0.28
      type: 13
      value: "\u2022 Corregidas las descripciones de los objetos para mejorar su
        gram\xE1tica y claridad."
      baseValue: "\u2022 Item descriptions have been corrected for grammar and clarity."
