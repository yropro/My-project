    - key: pSEK85cf.name
      type: 5
      value: Baldur (Enfurecido)
      baseValue: Baldur (Enraged)
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: LTCYMBG4.name
      type: 5
      value: "Basilisco (Cuerpo - L\xE1ser)"
      baseValue: Basilisk (Body - Laser)
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: ZMpFKcx6.name
      type: 5
      value: Basilisco (Cuerpo - Tornado)
      baseValue: Basilisk (Body - Tornado)
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: vVHMYbzU.name
      type: 5
      value: Basilisco (Cabeza)
      baseValue: Basilisk (Head)
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.0
      type: 2
      value: "Eficiente. Brutal. Sab\xEDa que no me decepcionar\xEDas."
      baseValue: Efficient. Brutal. I knew you wouldn't disappoint.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.1
      type: 2
      value: "Este componente nunca fue suyo. Perteneci\xF3 a los que vinieron antes."
      baseValue: This component was never theirs to begin with. It belonged to the
        ones who came before.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.2
      type: 2
      value: 
      baseValue: 
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: vVHMYbzU.echoPartDialog.3
      type: 2
      value: "No te demores. Hay m\xE1s que romper... y m\xE1s que construir."
      baseValue: Don't linger. There's more to break... and more to build.
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: We6Y09DS.name
      type: 5
      value: Basilisco (Cola)
      baseValue: Basilisk (Tail)
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: zIXoafRS.name
      type: 5
      value: Behemoth
      baseValue: Behemoth
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: wEQYPcKn.name
      type: 5
      value: Bloodroot
      baseValue: Bloodroot
      context: 
      aiTranslated: 1
      keptEnglish: 1
    - key: eWabNDzg.name
      type: 5
      value: Citadel (Armadura 1)
