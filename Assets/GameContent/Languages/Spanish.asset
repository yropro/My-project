      aiTranslated: 1
      keptEnglish: 0
    - key: core.updateHistory.v0.7.95.38
      type: 13
      value: "\u2022 Las llamas de quemadura ahora se desvanecen de forma natural
        en lugar de cortarse de golpe."
      baseValue: "\u2022 Burning flames now fade out naturally instead of being cut
        off abruptly."
