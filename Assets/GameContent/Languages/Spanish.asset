      baseValue: Credits and Attribution
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: PtAWL7BT
      type: 9
      value: Gracias por jugar
      baseValue: Thanks For Playing
      context: 
      aiTranslated: 1
      keptEnglish: 0
    - key: d0PwM3QM
      type: 8
      value: "\xA1Gracias por tomarte el tiempo de probar la demo!\n\n\xA1Star Vortex
        ya est\xE1 disponible en acceso anticipado! Consigue tu copia en Steam y
        contin\xFAa tu aventura. \xA1Todas las partidas guardadas se transfieren
        a la versi\xF3n completa!"
      baseValue: 'Thanks for taking the time to checkout the demo!


        Star
        Vortex is out now in Early Access! Grab your copy on Steam and continue your
        journey. All saves carry over to the full version!'
      context: 
      aiTranslated: 1
      keptEnglish: 0
